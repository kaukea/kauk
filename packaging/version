#!/bin/sh
# The version of this checkout, in SemVer 2, from git alone (the house's
# versioning skill). Each package system translates it; none computes its own.
#
#   on a release tag              that tag's version: 0.1.0-preview.1
#   after a preview tag           it continues:       0.1.0-preview.1.3+<sha>
#   after a final tag (v0.1.0)    the next patch:     0.1.1-preview.0.7+<sha>
#
# Every build sorts after the release before it and before any release after.
set -eu
cd "$(dirname "$0")/.."
commit=$(git rev-parse --short HEAD)
desc=$(git describe --tags --long --match 'v[0-9]*' 2>/dev/null) || {
    echo "no release tag to count from" >&2
    exit 1
}
tag=${desc%-*-g*}; ahead=${desc%-g*}; ahead=${ahead##*-}
release=${tag#v}
if [ "$ahead" = 0 ]; then
    echo "$release"
else
    case $release in
        *-preview.*) echo "$release.$ahead+$commit" ;;
        *) patch=${release##*.}
           echo "${release%.*}.$((patch + 1))-preview.0.$ahead+$commit" ;;
    esac
fi
