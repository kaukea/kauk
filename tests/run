#!/usr/bin/env bash
# Every suite, one after another: the gate a package is published behind.
# Exits non-zero if any check in any suite failed. Failure means no package.
#
#   tests/run
set -uo pipefail
cd "$(dirname "$0")"
failed=0
for t in *.sh; do
  [ "$t" = harness.sh ] && continue
  out=$(bash "$t" </dev/null 2>&1); rc=$?
  n=$(printf '%s\n' "$out" | grep -c '^  FAIL ')
  if [ "$rc" -ne 0 ] || [ "$n" -ne 0 ]; then
    failed=1
    printf 'FAIL %s (exit %s)\n' "$t" "$rc"
    printf '%s\n' "$out" | grep -A2 '^  FAIL ' | sed 's/^/     /'
  else
    printf 'ok   %s: %s\n' "$t" "$(printf '%s\n' "$out" | tail -1)"
  fi
done
[ "$failed" = 0 ] && echo "every suite passed"
exit "$failed"
