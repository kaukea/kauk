#!/usr/bin/env bash
# kaukea — the kai command, as a bash stopgap (kauk stays as the backup
# alias): distribution of file packages — skills, agents, shared rule files —
# for AI-agent-driven repositories. The real CLI ships at 0.1.0 and
# inherits this grammar; until then this bash MVP dies gracefully: delete .ai/
# and the symlinks, nothing else breaks.
#
#   kai init                              bootstrap THIS repo (no data source)
#   kai install <owner>/<repo> | <path>   add + lay a package source
#   kai sync [--status|--pull|--push]     the manual synchronisation: pull with
#                                          rebase and lay (the default); --pull
#                                          narrows to taking, --push to giving
#   kai resolve [--assist]                list destinations kai refused to touch;
#                                          --assist asks Claude to attempt a merge
#
# HEAD-TRACKING ONLY (Decision-051): versions, tags, locks and pins are one
# deferred piece of work. Sync is what sync always was — run when the operator
# wants it, pulling with rebase and laying. Push stays a separate, explicit act
# (--push, Decision-049); pending migrations run after a successful pull
# (Decision-022) and removals are warned about. A source carrying ref = "…" —
# a version, tag, or specific commit — is NOT touched: kauk lays what is there
# and leaves the clone alone until the versioning work exists. A rebase that
# conflicts stops and reports; merge handling beyond that is deferred. The
# "updates available" notice is a background check, not this command.
#
# .ai.toml is DEFAULTS-ONLY (Decision-047/049). A source table's key says it all:
#
#   [sources."<owner>/<repo>"]     resolves to https://github.com/<owner>/<repo>
#   [sources."/full/path"]         a local working tree; its <owner>/<repo>
#                                  identity derives from its origin remote, else
#                                  from the last two path components
#
# An `origin =` key on an <owner>/<repo> source is an ERROR — nothing else lives
# in a source table except the operator's selection:
#
#   select = ["process/orchard", "development", "misc/helper"]
#
# Package-relative category paths: a node takes its subtree, its ancestors' own
# artifacts, and the dependency closure; a "<category>/<artifact>" entry picks
# one artifact. No select key = everything, exactly as before selection existed.
#
# A package declares nothing centrally (Decision-046). Contents are determined
# BY CONVENTION — skills/ agents/ hooks/ tools/ files/ — and artifacts
# self-declare in frontmatter: `categories:` (with `roles:` read as fallback
# until the rename lands), dependencies as `dependencies-skills:` /
# `dependencies-agents:` / `dependencies-tools:` flat lists (the nested
# `dependencies:` map is accepted too), bare names within the package,
# `<package>/<category>/…/<artifact>` across packages.
#
# Everything laid is a symlink into the clone (absolute, so git worktrees
# resolve); a destination the user owns is reported and skipped, never replaced.
# Laying happens only AFTER selection.
set -euo pipefail

SELF_REPO="serialseb/kauk"

die() { printf 'kai: %s\n' "$1" >&2; exit 1; }
say() { printf '%s\n' "$1"; }

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"; }
clone_of() { echo "$1/.ai/repositories/$2"; }

# ---------- .ai.toml ----------
# The OPERATOR's file: what this checkout consumes, and nothing else.
src_tables() { # src_tables <root> -> one table key per line
  [ -f "$1/.ai.toml" ] || return 0
  awk '/^\[sources\."/ { s=$0; sub(/^\[sources\."/,"",s); sub(/"\].*$/,"",s); print s }' "$1/.ai.toml"
}

key_field() { # key_field <root> <tablekey> <field> -> quoted strings of that field
  [ -f "$1/.ai.toml" ] || return 0
  awk -v id="$2" -v key="$3" '
    /^\[sources\."/ { s=$0; sub(/^\[sources\."/,"",s); sub(/"\].*$/,"",s); cur=s; next }
    /^\[/           { cur="" }
    cur==id && $0 ~ "^"key"[ \t]*=" { n=split($0,a,"\""); for(i=2;i<=n;i+=2) if(a[i]!="") print a[i] }
  ' "$1/.ai.toml"
}

path_id() { # path_id <path> -> <owner>/<repo>: the last two path components
  local p=${1%/}          # Decision-143's vendoring rule; the origin remote is
  echo "$(basename "$(dirname "$p")")/$(basename "$p")"   # NOT consulted, so a
}                         # renamed remote never silently relocates a clone

sources_list() { # sources_list <root> -> "<id> <origin> <tablekey>" per line
  local root=$1 k o
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    case "$k" in
      /*)
        echo "$(path_id "$k") $k $k" ;;
      */*)
        o=$(key_field "$root" "$k" origin | head -1)
        [ -z "$o" ] || die "source \"$k\": origin is retired — an <owner>/<repo> source resolves to github.com/$k; a local source is keyed by its full path. Edit .ai.toml."
        echo "$k https://github.com/$k $k" ;;
      *)
        say "WARN .ai.toml: source \"$k\" is neither <owner>/<repo> nor a full path — ignored" ;;
    esac
  done < <(src_tables "$root")
}

source_origin() { sources_list "$1" | awk -v id="$2" '$1==id{v=$2} END{if(v!="")print v}'; }
source_key()    { sources_list "$1" | awk -v id="$2" '$1==id{v=$3} END{if(v!="")print v}'; }
source_select() { local k; k=$(source_key "$1" "$2"); [ -n "$k" ] && key_field "$1" "$k" select; return 0; }
source_ref()    { local k; k=$(source_key "$1" "$2"); [ -n "$k" ] && key_field "$1" "$k" ref | head -1; return 0; }

ensure_aitoml() {
  local root=$1 f="$root/.ai.toml"
  [ -f "$f" ] && return 0
  cat > "$f" <<'EOF'
# Yours to edit — this file says what this repository consumes.
# [sources."<owner>/<repo>"] resolves to github.com; [sources."/full/path"] is
# local. Each table may carry select = ["<category-path>", ...]; no select
# means everything. Clones sit at .ai/repositories/<owner>/<repo>/ (gitignored).
EOF
  say ".ai.toml: created"
}

register_source() { # register_source <root> <tablekey> — idempotent
  local root=$1 k=$2 f="$root/.ai.toml"
  grep -q "^\[sources\.\"$k\"\]" "$f" 2>/dev/null && return 0
  printf '\n[sources."%s"]\n' "$k" >> "$f"
  say ".ai.toml: registered source $k"
}

# ---------- package identity & convention ----------
KINDS="skills agents hooks tools files templates"

pkg_field() { sed -n "s/^$2[[:space:]]*=[[:space:]]*\"\(.*\)\"/\1/p" "$1/package.toml" 2>/dev/null | head -1; }
pkg_flag()  { grep -Eq "^$2[[:space:]]*=[[:space:]]*true[[:space:]]*$" "$1/package.toml" 2>/dev/null; }

is_package() {
  local src=$1 d
  [ -f "$src/package.toml" ] && return 0
  for d in $KINDS; do [ -d "$src/$d" ] && return 0; done
  return 1
}

same_path() { [ -d "$1" ] && [ -d "$2" ] && [ "$(cd "$1" && pwd -P)" = "$(cd "$2" && pwd -P)" ]; }

is_self_source() { # the repository IS this package — never vendored (Decision-037)
  local root=$1 origin; origin=$(source_origin "$root" "$2")
  [ -n "$origin" ] && [ -d "$origin" ] && same_path "$origin" "$root"
}

source_tree() { if is_self_source "$1" "$2"; then echo "$1"; else clone_of "$1" "$2"; fi; }
publish_mode() { if is_self_source "$1" "$2"; then echo copy; else echo link; fi; }

pkg_namespace() { # the package's own name, else the repo half of <owner>/<repo>
  local src=$1 id=$2 n; n=$(pkg_field "$src" name)
  echo "${n:-${id##*/}}"
}

# ---------- frontmatter ----------
# Artifacts self-declare (Decisions 046/047/048): `categories:` (roles: as
# fallback until the orchids rename lands), dependencies as flat
# `dependencies-<kind>:` lists or the nested `dependencies:` map, and their own
# files as globs. Kept trivially parseable for the thin CLI: flat inline lists.
fm_block() { awk 'NR==1 && $0!="---"{exit} NR>1 && $0=="---"{exit} NR>1{print}' "$1" 2>/dev/null; }

fm_list() { # fm_list <file> <key> -> items of an inline [a, b] or dash-block list
  [ -f "$1" ] || return 0
  fm_block "$1" | awk -v k="$2" '
    $0 ~ "^"k":[ \t]*\\[" {
      v=$0; sub("^"k":[ \t]*\\[","",v); sub("\\].*$","",v)
      n=split(v,a,","); for(i=1;i<=n;i++){gsub(/^[ \t"'\'']+|[ \t"'\'']+$/,"",a[i]); if(a[i]!="")print a[i]}
      next
    }
    $0 ~ "^"k":[ \t]*$" { inb=1; next }
    inb && /^[ \t]+-[ \t]/ { v=$0; sub(/^[ \t]+-[ \t]+/,"",v); gsub(/^["'\'']|["'\'']$/,"",v); print v; next }
    inb { inb=0 }
  '
}

fm_nested_dep() { # fm_nested_dep <file> <skills|agents|tools> — the map form
  [ -f "$1" ] || return 0
  fm_block "$1" | awk -v k="$2" '
    /^dependencies:[ \t]*$/ { ind=1; next }
    ind && /^[^ \t]/        { ind=0 }
    ind && $0 ~ "^[ \t]+"k":[ \t]*\\[" {
      v=$0; sub("^[ \t]+"k":[ \t]*\\[","",v); sub("\\].*$","",v)
      n=split(v,a,","); for(i=1;i<=n;i++){gsub(/^[ \t"'\'']+|[ \t"'\'']+$/,"",a[i]); if(a[i]!="")print a[i]}
    }
  '
}

artifact_file() { # artifact_file <src> <s|a> <name>
  case "$2" in
    s) echo "$1/skills/$3/SKILL.md" ;;
    a) echo "$1/agents/$3.md" ;;
  esac
}

artifact_categories() { # categories:, falling back to roles:
  local c; c=$(fm_list "$1" categories)
  [ -n "$c" ] && { printf '%s\n' "$c"; return 0; }
  fm_list "$1" roles
}

artifact_deps() { # artifact_deps <file> <owner-kind-letter> <skills|agents|tools>
  local f=$1 owner=$2 dk=$3 d
  d=$(fm_list "$f" "dependencies-$dk")
  [ -n "$d" ] || d=$(fm_nested_dep "$f" "$dk")
  # an agent's runtime skills: list is the same dependency edge (Decision-029/030)
  [ -z "$d" ] && [ "$owner" = a ] && [ "$dk" = skills ] && d=$(fm_list "$f" skills)
  printf '%s\n' "$d" | grep . || true
}

each_artifact() { # each_artifact <src> -> "<kind-letter> <name>" per line
  local src=$1 t
  for t in "$src"/skills/*/; do [ -e "$t" ] && echo "s $(basename "$t")"; done
  for t in "$src"/agents/*.md; do [ -e "$t" ] && echo "a $(basename "$t" .md)"; done
  return 0
}

# ---------- selection & closure ----------
# Selection is the operator's per-source select list; the installed set is its
# dependency closure (Decision-025/047). A declared path D matches an entry E
# when D==E, D lies under E, or E lies under D (a node brings its ancestors'
# own artifacts). "<category>/<artifact>" picks one artifact. Undeclared
# artifacts always lay; hooks, files/ and tools are never filtered.
SEL_ACTIVE=0
SEL_FILE=""
XDEPS=""

cat_hit() { # cat_hit <declared-paths (lines)> <entry>
  local d
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    case "$d" in "$2"|"$2"/*) return 0 ;; esac
    case "$2" in "$d"/*) return 0 ;; esac
  done <<< "$1"
  return 1
}

sel_add() { grep -qx "$1/$2" "$SEL_FILE" 2>/dev/null || echo "$1/$2" >> "$SEL_FILE"; }

sel_allows() { # sel_allows <kind-letter> <name>
  [ "$SEL_ACTIVE" = 0 ] && return 0
  case "$1" in s|a) grep -qx "$1/$2" "$SEL_FILE" ;; *) return 0 ;; esac
}

leaf_pick() { # leaf_pick <src> <entry> -> 0 if the entry named one artifact (and selected it)
  local src=$1 e=$2 name=${2##*/} cat k f decl
  cat=${e%/*}
  [ "$cat" != "$e" ] || return 1
  for k in s a; do
    f=$(artifact_file "$src" "$k" "$name")
    [ -e "$f" ] || continue
    decl=$(artifact_categories "$f")
    [ -n "$decl" ] && echo "$decl" | grep -qx "$cat" && { sel_add "$k" "$name"; return 0; }
  done
  return 1
}

close_selection() { # fixpoint over declared dependencies, in-package; cross-package staged
  local src=$1 id=$2 grew=1 k n f dk dn l ref
  while [ $grew = 1 ]; do
    grew=0
    while IFS=/ read -r k n; do
      case "$k" in s|a) ;; *) continue ;; esac
      f=$(artifact_file "$src" "$k" "$n")
      for dk in skills agents tools; do
        case "$dk" in skills) l=s ;; agents) l=a ;; tools) l=t ;; esac
        for ref in $(artifact_deps "$f" "$k" "$dk"); do
          [ "$l" = t ] && continue                 # tools lay unfiltered today
          case "$ref" in
            */*) echo "$l ${ref##*/} $k/$n ${ref%%/*}" >> "$XDEPS" ;;
            *)
              dn=$ref
              if [ -e "$(artifact_file "$src" "$l" "$dn")" ]; then
                if ! grep -qx "$l/$dn" "$SEL_FILE"; then
                  sel_add "$l" "$dn"
                  say "  closure: +$l/$dn (needed by $k/$n)"
                  grew=1
                fi
              else
                say "  WARN $id: $k/$n depends on $l/$dn, absent from this package"
              fi ;;
          esac
        done
      done
    done < "$SEL_FILE"
  done
}

build_selection() { # build_selection <root> <src> <id>
  local root=$1 src=$2 id=$3 entries e k n f decl
  SEL_ACTIVE=0; : > "$SEL_FILE"
  entries=$(source_select "$root" "$id")
  [ -n "$entries" ] || return 0
  SEL_ACTIVE=1
  while read -r k n; do
    [ -n "$k" ] || continue
    f=$(artifact_file "$src" "$k" "$n")
    decl=$(artifact_categories "$f")
    [ -z "$decl" ] && sel_add "$k" "$n"          # undeclared always lays
  done < <(each_artifact "$src")
  for e in $entries; do
    leaf_pick "$src" "$e" && continue
    while read -r k n; do
      [ -n "$k" ] || continue
      f=$(artifact_file "$src" "$k" "$n")
      decl=$(artifact_categories "$f")
      [ -n "$decl" ] && cat_hit "$decl" "$e" && sel_add "$k" "$n"
    done < <(each_artifact "$src")
  done
  close_selection "$src" "$id"
}

resolve_xdeps() { # cross-package closure by the name-rooted grammar (one level)
  local root=$1 l n needer pkg id origin key src found
  [ -s "$XDEPS" ] || return 0
  sort -u -o "$XDEPS" "$XDEPS"
  while read -r l n needer pkg; do
    [ -n "$l" ] || continue
    found=""
    while read -r id origin key; do
      [ -n "$id" ] || continue
      src=$(source_tree "$root" "$id")
      [ "$(pkg_namespace "$src" "$id")" = "$pkg" ] || continue
      [ -e "$(artifact_file "$src" "$l" "$n")" ] || [ -e "$src/tools/$n" ] && { found=$id; break; }
    done < <(sources_list "$root")
    if [ -n "$found" ]; then
      lay_one_artifact "$root" "$found" "$l" "$n"
      say "  closure: +$pkg/$l/$n (needed by $needer)"
    else
      say "  WARN: $needer depends on $pkg/…/$n, and no installed source is the package \"$pkg\""
    fi
  done < "$XDEPS"
  : > "$XDEPS"
}

lay_one_artifact() { # lay_one_artifact <root> <id> <kind-letter> <name>
  local root=$1 id=$2 l=$3 n=$4 src mode ns t dstdir
  src=$(source_tree "$root" "$id"); mode=$(publish_mode "$root" "$id"); ns=$(pkg_namespace "$src" "$id")
  case "$l" in
    s) t="$src/skills/$n";    dstdir="$root/.claude/skills" ;;
    a) t="$src/agents/$n.md"; dstdir="$root/.claude/agents"; n="$n.md" ;;
    t) t="$src/tools/$n";     dstdir="$root/.claude/tools" ;;
  esac
  mkdir -p "$dstdir"
  if [ "$mode" = copy ]; then NS_DST="$n"; else namespace_for "$dstdir" "$n" "$ns"; fi
  place_one "$mode" "$t" "$dstdir/$NS_DST" && LAID=$((LAID+1))
}

render_tree() { # render_tree <root> <id> — the derived tree, for the add-time conversation
  local root=$1 id=$2 src k n f decl c
  src=$(source_tree "$root" "$id")
  { while read -r k n; do
      [ -n "$k" ] || continue
      f=$(artifact_file "$src" "$k" "$n")
      decl=$(artifact_categories "$f")
      if [ -n "$decl" ]; then while IFS= read -r c; do echo "$c $k/$n"; done <<< "$decl"
      else echo "(uncategorised) $k/$n"; fi
    done < <(each_artifact "$src")
  } | sort | awk '{ if($1!=p){ printf "%s%s:", (NR>1?"\n":""), $1; p=$1 } printf " %s", $2 } END { print "" }'
}

offer_tree() { # after an unselected install: show the tree, invite a select
  local root=$1 id=$2 key
  [ -z "$(source_select "$root" "$id")" ] || return 0
  key=$(source_key "$root" "$id")
  say ""
  say "$id declares this tree; nothing is selected, so everything installed."
  render_tree "$root" "$id" | sed 's/^/  /'
  say "To trim, add under [sources.\"$key\"] in .ai.toml:  select = [\"<category-path>\", …]"
}

# ---------- runtime detection ----------
detect_runtimes() { # -> a SET, one name per line (Decision-018)
  local root=$1
  { [ -d "$root/.claude" ] || [ -f "$root/CLAUDE.md" ]; } && echo claude
  return 0
}

# ---------- layout ----------
LAID=0

place_one() { case "$1" in copy) copy_one "$2" "$3" ;; *) link_one "$2" "$3" ;; esac; }

NS_LOCAL="local"
NS_SEP=":"
NS_DST=""

namespace_for() { # a name collision keeps both, namespaced (Decision-042)
  local dstdir=$1 n=$2 ns=$3
  if [ -e "$dstdir/$NS_LOCAL$NS_SEP$n" ]; then NS_DST="$ns$NS_SEP$n"; return 0; fi
  if [ -e "$dstdir/$n" ] && [ ! -L "$dstdir/$n" ]; then
    mv "$dstdir/$n" "$dstdir/$NS_LOCAL$NS_SEP$n"
    say "  NAMESPACED $NS_LOCAL$NS_SEP$n (yours) and $ns$NS_SEP$n (package) — same name, different things"
    NS_DST="$ns$NS_SEP$n"; return 0
  fi
  NS_DST="$n"
}

lay_kind() { # lay_kind <mode> <src-dir> <dst-dir> <glob-suffix> <pkgns> <kind-letter>
  local mode=$1 srcdir=$2 dstdir=$3 ns=$5 kind=${6:-} t n
  [ -d "$srcdir" ] || return 0
  mkdir -p "$dstdir"
  for t in "$srcdir"/*$4; do
    [ -e "$t" ] || continue
    n=$(basename "$t")
    case "$n" in .*|__pycache__|*"$NS_SEP"*) continue ;; esac
    [ -n "$kind" ] && ! sel_allows "$kind" "$(basename "$n" .md)" && continue
    if [ "$mode" = copy ]; then NS_DST="$n"; else namespace_for "$dstdir" "$n" "$ns"; fi
    place_one "$mode" "$t" "$dstdir/$NS_DST" && LAID=$((LAID+1))
  done
}

lay_claude() { # lay_claude <root> <src> <mode> <pkgns>
  local root=$1 src=$2 mode=$3 ns=$4
  NS_SEP=":"
  lay_kind "$mode" "$src/skills" "$root/.claude/skills" ""    "$ns" s
  lay_kind "$mode" "$src/agents" "$root/.claude/agents" ".md" "$ns" a
  lay_kind "$mode" "$src/hooks"  "$root/.claude/hooks"  ""    "$ns"
  lay_kind "$mode" "$src/tools"  "$root/.claude/tools"  ""    "$ns"
}

lay_files() { # files/<path> -> <root>/<path>, verbatim (Decision-015)
  local root=$1 src=$2 mode=$3 rel
  [ -d "$src/files" ] || return 0
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    mkdir -p "$root/$(dirname "$rel")"
    place_one "$mode" "$src/files/$rel" "$root/$rel" && LAID=$((LAID+1))
  done < <(cd "$src/files" && find . -type f 2>/dev/null | sed 's|^\./||')
}

lay_source() { # lay_source <root> <id>  (idempotent; never destroys real files)
  local root=$1 id=$2 src mode rt runtimes ns
  src=$(source_tree "$root" "$id")
  is_package "$src" || { say "$id: no package contents — nothing to lay"; return 0; }
  mode=$(publish_mode "$root" "$id")
  ns=$(pkg_namespace "$src" "$id")

  runtimes=$(detect_runtimes "$root")
  if [ -z "$runtimes" ]; then
    say "$id: no agent runtime detected here — nothing laid"
    say "  (a repository is a Claude repository when it has .claude/ or CLAUDE.md)"
    return 0
  fi

  LAID=0
  build_selection "$root" "$src" "$id"
  for rt in $runtimes; do
    case "$rt" in
      claude) lay_claude "$root" "$src" "$mode" "$ns" ;;
      *)      say "  WARN $id: no renderer for runtime '$rt'" ;;
    esac
  done
  lay_files "$root" "$src" "$mode"
  prune_deselected "$root" "$src"
  SEL_ACTIVE=0
  say "$mode: $LAID laid/verified ($id) [$(echo "$runtimes" | tr '\n' ' ')]"
}

prune_deselected() { # a link whose artifact fell out of the selection is removed
  [ "$SEL_ACTIVE" = 1 ] || return 0
  local root=$1 src=$2 l t k n
  for l in "$root"/.claude/skills/* "$root"/.claude/agents/*; do
    [ -L "$l" ] || continue
    t=$(readlink "$l")
    case "$t" in
      "$src"/skills/*) k=s; n=${t#"$src"/skills/}; n=${n%%/*} ;;
      "$src"/agents/*) k=a; n=$(basename "$t" .md) ;;
      *) continue ;;
    esac
    sel_allows "$k" "$n" || { rm "$l"; say "  DESELECT ${l#"$root"/} (outside the selection)"; }
  done
}

CONFLICTS=""

link_one() { # link_one <abs-target> <linkpath> -> 0 correct, 1 blocked
  local target=$1 link=$2
  [ -e "$target" ] || { say "  SKIP $link (target missing in package)"; return 1; }
  if [ -L "$link" ]; then
    [ "$(readlink "$link")" = "$target" ] || ln -sfn "$target" "$link"
    return 0
  fi
  if [ -e "$link" ]; then
    say "  BLOCKED $link (a real file is already there — kai did not place it, so kai will not touch it)"
    CONFLICTS="$CONFLICTS$link|$target"$'\n'
    return 1
  fi
  ln -s "$target" "$link"
}

report_conflicts() { # invite the user to decide — never decide for them (Decision-041)
  [ -n "$CONFLICTS" ] || return 0
  local n; n=$(printf '%s' "$CONFLICTS" | grep -c . || true)
  say ""
  say "$n destination(s) already hold a file kai did not place. Nothing was changed."
  say "kai cannot tell which version you intended, so it will not choose. You can:"
  say "  kai resolve            list them with the package version alongside"
  say "  kai resolve --assist   ask Claude to attempt a merge, under the usual gates"
  say "  (or merge them yourself — that is always the fallback)"
}

copy_one() { # self-published packages copy into their own repo
  local src=$1 dst=$2
  [ -e "$src" ] || { say "  SKIP $dst (missing in package)"; return 1; }
  case "$dst" in */.claude/*|"$PWD"/*) ;; *) die "refusing to write outside a published destination: $dst" ;; esac
  [ -L "$dst" ] && rm "$dst"
  if [ -d "$src" ]; then
    [ -d "$dst" ] && diff -rq "$src" "$dst" >/dev/null 2>&1 && return 0
    rm -rf "${dst:?}"; cp -r "$src" "$dst"; return 0
  fi
  cmp -s "$src" "$dst" 2>/dev/null && return 0
  cp "$src" "$dst"
}

prune_links() { # remove dead symlinks pointing into this repo's .ai/repositories/
  local root=$1 l
  while IFS= read -r l; do
    [ -e "$l" ] && continue
    case "$(readlink "$l")" in
      "$root/.ai/repositories/"*) rm "$l"; say "  PRUNE ${l#"$root"/} (target gone from package)" ;;
    esac
  done < <(find "$root/.claude" -type l 2>/dev/null; find "$root" -maxdepth 1 -type l 2>/dev/null)
}

ensure_gitignore() {
  local root=$1
  grep -qx '\.ai/repositories/' "$root/.gitignore" 2>/dev/null || printf '.ai/repositories/\n' >> "$root/.gitignore"
}

# ---------- migrations ----------
pkg_artifact_names() { # pkg_artifact_names <src> -> kind/name per line, sorted
  local src=$1 t
  { for t in "$src"/skills/*/; do [ -e "$t" ] && echo "s/$(basename "$t")"; done
    for t in "$src"/agents/*.md; do [ -e "$t" ] && echo "a/$(basename "$t" .md)"; done
    for t in "$src"/hooks/* "$src"/tools/*; do [ -e "$t" ] && echo "x/$(basename "$t")"; done
    :
  } 2>/dev/null | sort
}

run_pending_migrations() { # run_pending_migrations <root> <id> <src>
  local root=$1 id=$2 src=$3 gcd wm last f base
  [ -d "$src/migrations" ] || return 0
  gcd=$(git -C "$root" rev-parse --git-common-dir)
  case "$gcd" in /*) ;; *) gcd="$root/$gcd" ;; esac
  wm="$gcd/the-works/migrated/$id"; last=""
  [ -f "$wm" ] && last=$(cat "$wm")
  for f in "$src"/migrations/*.md; do
    [ -e "$f" ] || continue
    base=$(basename "$f" .md)
    if [ -n "$last" ]; then [ "$base" \> "$last" ] || continue; fi
    say "  migration $base: running scripted steps"
    if awk '/^```sh$/{b=1;next} /^```/{b=0} b' "$f" | (cd "$root" && bash); then
      mkdir -p "$(dirname "$wm")"; printf '%s\n' "$base" > "$wm"
      say "  migration $base: applied (judgement steps, if any, are prose in the file)"
    else
      say "  migration $base: FAILED — apply manually, then advance $wm"
      return 1
    fi
  done
}

# ---------- package dependencies ----------
# package.toml may declare `dependencies = ["<owner>/<repo>", …]` — the package
# graph resolves first, the artifact closure then runs across the union
# (Decision-038, build authorised 2026-08-13).
pkg_dep_sources() {
  [ -f "$1/package.toml" ] || return 0
  awk '/^dependencies[ \t]*=/ { n=split($0,a,"\""); for(i=2;i<=n;i+=2) if(a[i]!="") print a[i] }' "$1/package.toml"
}

ensure_dep_sources() { # ensure_dep_sources <root> <id> — install missing package deps
  local root=$1 id=$2 src dep key
  src=$(source_tree "$root" "$id")
  for dep in $(pkg_dep_sources "$src"); do
    case "$dep" in */*) ;; *) say "  WARN $id: package dependency '$dep' is not <owner>/<repo> — ignored"; continue ;; esac
    key=$(source_key "$root" "$dep")     # an existing registration (path or repo form) wins
    [ -n "$key" ] && [ -d "$(clone_of "$root" "$dep")/.git" ] && continue
    say "  dependency: $dep (required by $id)"
    install_source "$root" "${key:-$dep}" || say "  WARN $id: could not install dependency $dep"
  done
}

# ---------- install ----------
install_source() { # install_source <root> <tablekey-or-id> — register, clone, lay
  local root=$1 ref=$2 id origin clone src
  case "$ref" in
    /*) register_source "$root" "$ref"; id=$(path_id "$ref") ;;
    */*) register_source "$root" "$ref"; id=$ref ;;
    *) say "  WARN install: '$ref' is neither <owner>/<repo> nor a full path"; return 1 ;;
  esac
  origin=$(source_origin "$root" "$id")
  if is_self_source "$root" "$id"; then
    src="$root"
    say "self: $id is this repository — not vendored, published from the working tree"
  else
    clone=$(clone_of "$root" "$id")
    if [ ! -d "$clone/.git" ]; then
      mkdir -p "$(dirname "$clone")"
      git clone --quiet "$origin" "$clone" 2>/dev/null || { say "  WARN $id: clone failed from $origin"; return 1; }
      say "clone: $clone"
    else
      say "clone: already present"
    fi
    src="$clone"
    [ -d "$origin/.git" ] && git -C "$origin" config receive.denyCurrentBranch updateInstead
  fi
  is_package "$src" || { say "  WARN $id has no package contents — not a kai package (expects any of: $KINDS)"; return 1; }

  # A destination the user owns is REPORTED AND SKIPPED (Decision-016); a name
  # collision is namespaced (Decision-042); nothing is dispatched (Decision-041).
  lay_source "$root" "$id"
  ensure_dep_sources "$root" "$id"
}

cmd_install() {
  local ref=${1:-}
  [ -n "$ref" ] || die "usage: kai install <owner>/<repo> | <path>"
  local root; root=$(repo_root)
  ensure_aitoml "$root"
  ensure_gitignore "$root"
  install_source "$root" "$ref" || die "install: $ref failed"
  resolve_xdeps "$root"
  prune_links "$root"
  local id; case "$ref" in /*) id=$(path_id "$ref") ;; *) id=$ref ;; esac
  say "install: $id done"
  offer_tree "$root" "$id"
  report_conflicts
}

# ---------- resolve ----------
collect_conflicts() {
  local root=$1 id origin key
  CONFLICTS=""
  while read -r id origin key; do
    [ -n "$id" ] || continue
    lay_source "$root" "$id" >/dev/null
  done < <(sources_list "$root")
}

cmd_resolve() {
  local root; root=$(repo_root)
  local assist=0
  [ "${1:-}" = "--assist" ] && assist=1
  collect_conflicts "$root"
  [ -n "$CONFLICTS" ] || { say "resolve: nothing to resolve — no destination holds a file kai did not place"; return 0; }

  local link target list=""
  while IFS='|' read -r link target; do
    [ -n "$link" ] || continue
    say "  ${link#"$root"/}"
    say "      yours:   $link"
    say "      package: $target"
    list="$list ${link#"$root"/}"
  done < <(printf '%s' "$CONFLICTS")

  if [ $assist = 0 ]; then
    say ""
    say "Merge them yourself, or run 'kai resolve --assist' to have Claude attempt it."
    return 0
  fi

  command -v claude >/dev/null 2>&1 || die "claude is not on PATH — merge these yourself"
  say ""
  say "Attempting an assisted merge for:$list"
  say "It follows the normal gates: it proposes, you approve, nothing is committed."
  claude -p "You are in the git repository $root. These paths each hold a file the user owns, and a package wants to provide its own version at the same path:$list. For EACH: read the user's file, read the package version (the path is printed above as 'package:'), and judge whether a SIMPLE, unambiguous merge exists — one that loses nothing the user wrote. If it does, show the proposed result and explain it. If it does not, say so plainly and stop: the user resolves it themselves. Change nothing on disk. Commit nothing." --output-format text \
    || say "assisted merge did not complete — resolve these yourself"
}

# ---------- init ----------
cmd_init() {
  local root; root=$(repo_root)
  local script_repo
  ensure_aitoml "$root"
  ensure_gitignore "$root"
  script_repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
  if same_path "$script_repo" "$root"; then
    install_source "$root" "$root" || true
    prune_links "$root"
    say "init: done — this repository is itself the kai package (self-published)"
    return 0
  fi
  install_source "$root" "${KAUK_ORIGIN:-$script_repo}" || true
  prune_links "$root"
  say "init: done — add a data package with 'kai install <owner>/<repo> | <path>'"
}

# ---------- sync ----------
# Bare sync converges to the pin and notifies. --pull takes updates; --push
# publishes local edits. Rebase is the default; a conflict stops and reports
# (Decision-050). Migrations run at --pull (Decision-022/043).
commit_local_edits() { # preserve uncommitted clone edits so the rebase carries them
  local clone=$1
  [ -n "$(git -C "$clone" status --porcelain)" ] || return 0
  git -C "$clone" add -A
  git -C "$clone" commit --quiet -m "🔁 local edits, preserved for rebase"
}

rebase_onto() { # rebase_onto <id> <clone> <target> -> 0 ok; 1 conflict (aborted, reported)
  local id=$1 clone=$2 target=$3
  git -C "$clone" rebase --quiet "$target" 2>/dev/null && return 0
  git -C "$clone" rebase --abort 2>/dev/null || true
  say "$id: rebase onto $target CONFLICTS — nothing changed; the merge storyline is yours (clone: $clone)"
  return 1
}

sync_source() { # sync_source <root> <id> <pull:0|1> <push:0|1>
  local root=$1 id=$2 pull=$3 push=$4 clone origin target before after gone
  if is_self_source "$root" "$id"; then
    lay_source "$root" "$id"
    say "sync: $id (self-published from the working tree — not vendored)"
    return 0
  fi
  clone=$(clone_of "$root" "$id")
  if [ ! -d "$clone/.git" ]; then
    origin=$(source_origin "$root" "$id")
    mkdir -p "$(dirname "$clone")"
    git clone --quiet "$origin" "$clone" 2>/dev/null || { say "$id: clone failed from $origin (offline?)"; return 0; }
    say "clone: $clone"
    [ -d "$origin/.git" ] && git -C "$origin" config receive.denyCurrentBranch updateInstead
  fi

  # a ref'd source — version, tag, or commit — is not kauk's to move (Decision-051)
  if [ -n "$(source_ref "$root" "$id")" ]; then
    say "$id: ref'd — left untouched until the versioning work; laying what is there"
    lay_source "$root" "$id"
    return 0
  fi

  git -C "$clone" fetch --quiet origin 2>/dev/null || true
  target=main
  git -C "$clone" rev-parse --verify --quiet origin/main >/dev/null && target=origin/main

  before=$(pkg_artifact_names "$clone")
  commit_local_edits "$clone"
  if ! rebase_onto "$id" "$clone" "$target"; then
    lay_source "$root" "$id"
    return 0
  fi
  after=$(pkg_artifact_names "$clone")
  gone=$(comm -23 <(echo "$before") <(echo "$after") | grep . || true)
  if [ -n "$gone" ]; then
    say "  WARN $id: this sync removes or renames artifacts a running session may still hold:"
    echo "$gone" | sed 's/^/    /'
  fi

  if [ "$push" = 1 ]; then
    if pkg_flag "$clone" pull-only; then
      say "$id: pull-only package — consumers never push back; your edits stay local"
    elif git -C "$clone" push --quiet origin "HEAD:main" 2>/dev/null; then
      say "push: $id → $(git -C "$clone" rev-parse --short HEAD) published"
    else
      say "$id: push failed (offline, or no write access) — your edits stay committed in the clone"
    fi
  fi

  lay_source "$root" "$id"
  run_pending_migrations "$root" "$id" "$clone" || true
  ensure_dep_sources "$root" "$id"
  say "sync: $id ($(git -C "$clone" rev-parse --short HEAD))"
}

status_source() { # status_source <root> <id>
  local root=$1 id=$2 clone dirty ahead behind
  clone=$(clone_of "$root" "$id")
  [ -d "$clone/.git" ] || { say "$id: no clone"; return 0; }
  git -C "$clone" fetch --quiet origin 2>/dev/null || { say "$id: fetch failed (offline?)"; return 0; }
  dirty=$(git -C "$clone" status --porcelain | wc -l)
  ahead=$(git -C "$clone" rev-list --count origin/main..HEAD)
  behind=$(git -C "$clone" rev-list --count HEAD..origin/main)
  say "$id: $behind incoming · $ahead outgoing · $dirty uncommitted local edit(s)"
  lay_source "$root" "$id"
}

cmd_sync() {
  local root; root=$(repo_root)
  local status_only=0 pull=0 push=0 a
  for a in "$@"; do
    case "$a" in
      --status) status_only=1 ;;
      --pull)   pull=1 ;;
      --push)   push=1 ;;
      *) die "usage: kai sync [--status | --pull | --push]" ;;
    esac
  done
  [ "$pull" = 1 ] && [ "$push" = 1 ] && die "one of --pull or --push — taking and giving are separate acts"
  local list; list=$(sources_list "$root")
  [ -n "$list" ] || die "no sources in .ai.toml — run 'kai init' first"
  local id origin key
  while read -r id origin key; do
    [ -n "$id" ] || continue
    if [ $status_only = 1 ]; then status_source "$root" "$id"; else sync_source "$root" "$id" "$pull" "$push"; fi
  done < <({ echo "$list" | grep -v "^$SELF_REPO " || true; echo "$list" | grep "^$SELF_REPO " || true; })
  [ $status_only = 1 ] || resolve_xdeps "$root"
  prune_links "$root"
  report_conflicts
}

main() {
  SEL_FILE=$(mktemp); XDEPS=$(mktemp)
  trap 'rm -f "$SEL_FILE" "$XDEPS"' EXIT
  case "${1:-}" in
    init)    shift; cmd_init "$@" ;;
    install) shift; cmd_install "$@" ;;
    sync)    shift; cmd_sync "$@" ;;
    resolve) shift; cmd_resolve "$@" ;;
    *) die "usage: kai init | install <owner>/<repo> | <path> | sync [--status|--pull|--push] | resolve [--assist]" ;;
  esac
}
main "$@"
