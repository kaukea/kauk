#!/usr/bin/env bash
# kaukea — the kai command, as a bash stopgap (kauk stays as the backup
# alias): distribution of file packages — skills, agents, shared rule files —
# for AI-agent-driven repositories. The real CLI ships at 0.1.0 and
# inherits this grammar; until then this bash MVP dies gracefully: delete .ai/
# and the symlinks, nothing else breaks.
#
#   kai init                              bootstrap THIS repo (no data source)
#   kai install <owner>/<repo> | <uri> | <path>   add + lay a dependency
#   kai sync [--status|--pull|--push]     the manual synchronisation: pull with
#                                          rebase and lay (the default); --pull
#                                          narrows to taking, --push to giving
#   kai resolve [--assist]                list destinations kai refused to touch;
#                                          --assist asks Claude to attempt a merge
#
# ONE configuration file per repository: .ai.toml, at its root
# (docs/configuration-files.md, the operator's own). Its root table says what
# THIS repository is; its [[dependency]] entries say what it consumes.
#
#   name = "my-thing"          # optional; defaults to the directory name
#   type = "package"           # optional; "project" when absent
#
#   [[dependency]]
#   type = "package"           # optional; the only value acted on today
#   source = "kaukea/orchard"  # owner/repo, a git URI, or a local path
#   include = ["process/orchard", "development"]
#
# A source is one of: <owner>/<repo> (resolved to github.com), a full git URI,
# an absolute path, or a ./relative path (against this repository's root). It
# may end in @HEAD. Any other ref — a branch, a tag, a commit — is NOT acted on
# until the versioning work exists (operator, 2026-08-26): the clone is left
# where it is and what is there is laid.
#
# include is the operator's selection, package-relative category paths: a node
# takes its subtree, its ancestors' own artifacts, and the dependency closure;
# a "<category>/<artifact>" entry picks one artifact. No include key = every
# artifact. It is accepted on git sources only — a local path is a development
# convenience that has to be replaced before publishing, and a selection that
# does not survive that swap is a trap (operator, 2026-08-26).
#
# The file is the operator's. kai only ever APPENDS one [[dependency]] block to
# it, at install, after the last dependency already there. It writes nothing
# else into it, and stamps its own name on nothing it writes anywhere.
#
# A package declares nothing centrally (Decision-046). Contents are determined
# BY CONVENTION — skills/ agents/ hooks/ tools/ files/ — and artifacts
# self-declare in frontmatter: `categories:` (with `roles:` read as fallback
# until the rename lands), dependencies as `dependencies-skills:` /
# `dependencies-agents:` / `dependencies-tools:` flat lists (the nested
# `dependencies:` map is accepted too), bare names within the package,
# `<package>/<category>/…/<artifact>` across packages.
#
# HEAD-TRACKING ONLY (Decision-051): versions, tags, locks and pins are one
# deferred piece of work. Sync is what sync always was — run when the operator
# wants it, pulling with rebase and laying. Push stays a separate, explicit act
# (--push, Decision-049); pending migrations run after a successful pull
# (Decision-022) and removals are warned about.
#
# Everything laid is a symlink into the clone (absolute, so git worktrees
# resolve); a destination the user owns is reported and skipped, never replaced.
# Laying happens only AFTER selection.
set -euo pipefail

die() { printf 'kai: %s\n' "$1" >&2; exit 1; }
say()  { printf '%s\n' "$1"; }
warn() { printf '%s\n' "$1" >&2; }   # never into a list a caller is reading

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"; }
clone_of() { echo "$1/.ai/repositories/$2"; }

# ---------- .ai.toml ----------
# The OPERATOR's file, and the only configuration file there is. Root table:
# this repository's own identity. [[dependency]] blocks: what it consumes.
# Read line by line, in the same awk style as the rest of this stopgap; an
# include list may span lines, nothing else may.

ai_file() { echo "$1/.ai.toml"; }

AWK_UNQ='
  function unq(s,   q) {
    sub(/^[ \t]*[A-Za-z_][A-Za-z_0-9-]*[ \t]*=[ \t]*/, "", s)
    if (substr(s, 1, 1) == "\"") { q = substr(s, 2); sub(/".*$/, "", q); return q }
    sub(/[ \t]*#.*$/, "", s); sub(/[ \t]+$/, "", s); sub(/^[ \t]+/, "", s)
    return s
  }
  function arr(s,   n, a, i, out) {
    sub(/^[^[]*\[/, "", s); sub(/\].*$/, "", s)
    n = split(s, a, ",")
    for (i = 1; i <= n; i++) {
      gsub(/^[ \t"'"'"']+|[ \t"'"'"']+$/, "", a[i])
      if (a[i] != "") out = out (out ? "," : "") a[i]
    }
    return out
  }
'

root_field() { # root_field <repo-or-clone> <field> -> value from the root table
  local f; f=$(ai_file "$1")
  [ -f "$f" ] || return 0
  awk -v key="$2" "$AWK_UNQ"'
    /^[ \t]*\[/ { exit }
    $0 ~ "^[ \t]*" key "[ \t]*=" { print unq($0); exit }
  ' "$f"
}

dep_rows() { # dep_rows <root> -> "<source>\t<type>\t<include-csv>" per dependency
  local f; f=$(ai_file "$1")
  [ -f "$f" ] || return 0
  awk "$AWK_UNQ"'
    function flush() {
      if (indep && src != "") printf "%s|%s|%s\n", src, typ, inc
      src = ""; typ = ""; inc = ""
    }
    /^[ \t]*\[\[dependency\]\][ \t]*$/ { flush(); indep = 1; next }
    /^[ \t]*\[/                        { flush(); indep = 0; next }
    inarr {
      buf = buf " " $0
      if ($0 ~ /\]/) { inc = arr(buf); inarr = 0; buf = "" }
      next
    }
    indep && /^[ \t]*source[ \t]*=/  { src = unq($0); next }
    indep && /^[ \t]*type[ \t]*=/    { typ = unq($0); next }
    indep && /^[ \t]*include[ \t]*=/ {
      buf = $0
      if (buf ~ /\]/) { inc = arr(buf) } else { inarr = 1 }
      next
    }
    END { flush() }
  ' "$f"
}

dep_sources() { dep_rows "$1" | cut -d'|' -f1; }

path_id() { # path_id <path> -> <owner>/<repo>: the last two path components
  local p=${1%/}          # the origin remote is NOT consulted, so a renamed
  echo "$(basename "$(dirname "$p")")/$(basename "$p")"   # remote never
}                                                          # relocates a clone

split_ref() { # split_ref <source> -> the @ref after the last /, or nothing
  local tail=${1##*/}
  case "$tail" in *@*) echo "${tail##*@}" ;; esac
}

strip_ref() { # strip_ref <source> -> the source with its @ref removed
  local r; r=$(split_ref "$1")
  [ -z "$r" ] && { echo "$1"; return 0; }
  echo "${1%@$r}"
}

abs_path() { # abs_path <root> <path> -> ./relative resolved against the repository
  case "$2" in
    /*) echo "${2%/}" ;;
    *)  echo "${1%/}/${2#./}" | sed 's|/*$||' ;;
  esac
}

uri_id() { # uri_id <git-uri> -> <owner>/<repo>
  local u=${1%.git} tail
  u=${u%/}
  tail=${u##*:}                 # git@host:owner/repo -> owner/repo
  case "$tail" in
    */*) echo "$(basename "$(dirname "$tail")")/$(basename "$tail")" ;;
    *)   echo "$(basename "$(dirname "$u")")/$(basename "$u")" ;;
  esac
}

deps_list() { # deps_list <root> -> "<id> <origin> <source-as-written>" per line
  local root=$1 raw typ inc bare
  while IFS='|' read -r raw typ inc; do
    [ -n "$raw" ] || continue
    case "$typ" in ''|package) ;; *) warn "WARN .ai.toml: dependency \"$raw\" has type \"$typ\" — only packages are acted on; ignored"; continue ;; esac
    bare=$(strip_ref "$raw")
    case "$bare" in
      *://*|git@*)
        echo "$(uri_id "$bare") $bare $raw" ;;
      /*|./*|../*)
        bare=$(abs_path "$root" "$bare")
        echo "$(path_id "$bare") $bare $raw" ;;
      */*)
        echo "$bare https://github.com/$bare $raw" ;;
      *)
        warn "WARN .ai.toml: source \"$raw\" is not <owner>/<repo>, a git URI, or a path — ignored" ;;
    esac
  done < <(dep_rows "$root")
}

validate_config() { # the config errors worth stopping for, reported before any work
  local root=$1 raw typ inc
  while IFS='|' read -r raw typ inc; do
    [ -n "$raw" ] || continue
    [ -n "$inc" ] || continue
    case "$(strip_ref "$raw")" in
      /*|./*|../*)
        die "dependency \"$raw\" carries an include list. include is accepted on git sources only: a local path is a development convenience that has to be replaced by its git source before publishing, and a selection that does not survive that swap is a trap. Remove the include, or point the dependency at the git source." ;;
    esac
  done < <(dep_rows "$root")
}

store_ids() { # every package this repository actually HAS, from the store itself
  local root=$1 d id
  for d in "$root"/.ai/repositories/*/*/; do
    [ -d "${d}.git" ] || continue
    id=${d#"$root/.ai/repositories/"}; id=${id%/}
    printf '%s\n' "$id"
  done
  return 0
}

sync_list() { # what sync works on: what .ai.toml declares, plus what the store
               # already holds. A package a repository has been given is a fact
               # of the store, and it has to keep receiving its migrations even
               # while the file that declares it is mid-conversion. Undeclared
               # clones are still swept at the end of the run, as before.
  local root=$1 declared id origin
  declared=$(deps_list "$root")
  printf '%s\n' "$declared" | grep . || true
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    printf '%s\n' "$declared" | awk -v i="$id" '$1==i{f=1} END{exit !f}' && continue
    origin=$(git -C "$root/.ai/repositories/$id" remote get-url origin 2>/dev/null) || continue
    [ -n "$origin" ] || continue
    printf '%s %s (store)\n' "$id" "$origin"
  done < <(store_ids "$root")
}

dep_origin() { deps_list "$1" | awk -v id="$2" '$1==id{v=$2} END{if(v!="")print v}'; }
dep_source() { deps_list "$1" | awk -v id="$2" '$1==id{v=$3} END{if(v!="")print v}'; }

dep_include() { # dep_include <root> <id> -> one category path per line
  local raw; raw=$(dep_source "$1" "$2")
  [ -n "$raw" ] || return 0
  dep_rows "$1" | awk -F'|' -v s="$raw" '$1==s{print $3; exit}' | tr ',' '\n' | grep . || true
}

dep_ref() { # dep_ref <root> <id> -> HEAD, a branch/tag/commit, or nothing
  local raw; raw=$(dep_source "$1" "$2")
  [ -n "$raw" ] && split_ref "$raw"
  return 0
}

# A repository declares itself a package with type = "package" in the ROOT
# TABLE of its own .ai.toml (docs/configuration-files.md). When set, it applies
# its own migrations/ to itself, lays its own agents/skills, and publishes its
# own files by copy (see lay_self). When absent, it is an ordinary project.
is_package_repo() { [ "$(root_field "$1" type)" = package ]; }

ensure_aitoml() { # created empty: its contents are the operator's, not kai's
  local root=$1 f; f=$(ai_file "$root")
  [ -f "$f" ] && return 0
  : > "$f"
  say ".ai.toml: created"
}

register_dependency() { # append one [[dependency]] after the last one — idempotent
  local root=$1 raw=$2 f last end
  f=$(ai_file "$root")
  dep_sources "$root" | grep -qxF "$raw" && return 0
  last=$(grep -n '^[ \t]*\[\[dependency\]\][ \t]*$' "$f" 2>/dev/null | tail -1 | cut -d: -f1)
  if [ -z "$last" ]; then
    [ -s "$f" ] && printf '\n' >> "$f"
    printf '[[dependency]]\nsource = "%s"\n' "$raw" >> "$f"
  else
    end=$(awk -v s="$last" 'NR>s && /^[ \t]*\[/ { print NR-1; exit }' "$f")
    [ -n "$end" ] || end=$(wc -l < "$f")
    { [ "$end" -gt 0 ] && head -n "$end" "$f"
      printf '\n[[dependency]]\nsource = "%s"\n' "$raw"
      tail -n +$((end + 1)) "$f"
    } > "$f.kai-tmp" && mv "$f.kai-tmp" "$f"
  fi
  say ".ai.toml: registered dependency $raw"
}

# ---------- package identity & convention ----------
KINDS="skills agents hooks tools files templates"

is_package() { # does this tree CARRY package contents — by convention, nothing else
  local src=$1 d
  for d in $KINDS; do [ -d "$src/$d" ] && return 0; done
  return 1
}

same_path() { [ -d "$1" ] && [ -d "$2" ] && [ "$(cd "$1" && pwd -P)" = "$(cd "$2" && pwd -P)" ]; }

# A declared source is always vendored, never inferred to be "this repository"
# by comparing its path against root (is_self_source is retired, 2026-08-19):
# .ai.toml is the operator's file and no behaviour hangs off what they wrote
# in it. Self-application is exclusively the root table's type = "package" — see
# is_package_repo and lay_self.
source_tree()  { clone_of "$1" "$2"; }
publish_mode() { echo link; }

pkg_namespace() { # the package's own name, else the repo half of <owner>/<repo>
  local src=$1 id=$2 n; n=$(root_field "$src" name)
  echo "${n:-${id##*/}}"
}

# ---------- frontmatter ----------
# Artifacts self-declare (Decisions 046/047/048): `categories:` (`roles:` is
# still read as a fallback, for the packages whose declarations have not been
# converted to the newer key yet), dependencies as flat
# `dependencies-<kind>:` lists or the nested `dependencies:` map, and their own
# files as globs. Kept trivially parseable for the thin CLI: flat inline lists.
fm_block() { awk 'NR==1 && $0!="---"{exit} NR>1 && $0=="---"{exit} NR>1{print}' "$1" 2>/dev/null; }

fm_list() { # fm_list <file> <key> -> items of an inline [a, b] or dash-block list
  [ -f "$1" ] || return 0
  fm_block "$1" | awk -v k="$2" '
    $0 ~ "^"k":[ \t]*\\[" {
      v=$0; sub("^"k":[ \t]*\\[","",v); sub("\\].*$","",v)
      n=split(v,a,","); for(i=1;i<=n;i++){gsub(/^[ \t"'\'']+|[ \t"'\'']+$/,"",a[i]); if(a[i]!="")print a[i]}
      next
    }
    $0 ~ "^"k":[ \t]*$" { inb=1; next }
    inb && /^[ \t]+-[ \t]/ { v=$0; sub(/^[ \t]+-[ \t]+/,"",v); gsub(/^["'\'']|["'\'']$/,"",v); print v; next }
    inb { inb=0 }
  '
}

fm_nested_dep() { # fm_nested_dep <file> <skills|agents|tools> — the map form
  [ -f "$1" ] || return 0
  fm_block "$1" | awk -v k="$2" '
    /^dependencies:[ \t]*$/ { ind=1; next }
    ind && /^[^ \t]/        { ind=0 }
    ind && $0 ~ "^[ \t]+"k":[ \t]*\\[" {
      v=$0; sub("^[ \t]+"k":[ \t]*\\[","",v); sub("\\].*$","",v)
      n=split(v,a,","); for(i=1;i<=n;i++){gsub(/^[ \t"'\'']+|[ \t"'\'']+$/,"",a[i]); if(a[i]!="")print a[i]}
    }
  '
}

artifact_file() { # artifact_file <src> <s|a> <name>
  case "$2" in
    s) echo "$1/skills/$3/SKILL.md" ;;
    a) echo "$1/agents/$3.md" ;;
  esac
}

artifact_categories() { # categories:, falling back to roles:
  local c; c=$(fm_list "$1" categories)
  [ -n "$c" ] && { printf '%s\n' "$c"; return 0; }
  fm_list "$1" roles
}

artifact_deps() { # artifact_deps <file> <owner-kind-letter> <skills|agents|tools>
  local f=$1 owner=$2 dk=$3 d
  d=$(fm_list "$f" "dependencies-$dk")
  [ -n "$d" ] || d=$(fm_nested_dep "$f" "$dk")
  # an agent's runtime skills: list is the same dependency edge (Decision-029/030)
  [ -z "$d" ] && [ "$owner" = a ] && [ "$dk" = skills ] && d=$(fm_list "$f" skills)
  printf '%s\n' "$d" | grep . || true
}

each_artifact() { # each_artifact <src> -> "<kind-letter> <name>" per line
  local src=$1 t
  for t in "$src"/skills/*/; do [ -e "$t" ] && echo "s $(basename "$t")"; done
  for t in "$src"/agents/*.md; do [ -e "$t" ] && echo "a $(basename "$t" .md)"; done
  return 0
}

# ---------- selection & closure ----------
# Selection is the operator's per-dependency include list; the installed set is its
# dependency closure (Decision-025/047). A declared path D matches an entry E
# when D==E, D lies under E, or E lies under D (a node brings its ancestors'
# own artifacts). "<category>/<artifact>" picks one artifact. Undeclared
# artifacts always lay; hooks, files/ and tools are never filtered.
SEL_ACTIVE=0
SEL_FILE=""
XDEPS=""

cat_hit() { # cat_hit <declared-paths (lines)> <entry>
  local d
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    case "$d" in "$2"|"$2"/*) return 0 ;; esac
    case "$2" in "$d"/*) return 0 ;; esac
  done <<< "$1"
  return 1
}

sel_add() { grep -qx "$1/$2" "$SEL_FILE" 2>/dev/null || echo "$1/$2" >> "$SEL_FILE"; }

sel_allows() { # sel_allows <kind-letter> <name>
  [ "$SEL_ACTIVE" = 0 ] && return 0
  case "$1" in s|a) grep -qx "$1/$2" "$SEL_FILE" ;; *) return 0 ;; esac
}

leaf_pick() { # leaf_pick <src> <entry> -> 0 if the entry named one artifact (and selected it)
  local src=$1 e=$2 name=${2##*/} cat k f decl
  cat=${e%/*}
  [ "$cat" != "$e" ] || return 1
  for k in s a; do
    f=$(artifact_file "$src" "$k" "$name")
    [ -e "$f" ] || continue
    decl=$(artifact_categories "$f")
    [ -n "$decl" ] && echo "$decl" | grep -qx "$cat" && { sel_add "$k" "$name"; return 0; }
  done
  return 1
}

close_selection() { # fixpoint over declared dependencies, in-package; cross-package staged
  local src=$1 id=$2 grew=1 k n f dk dn l ref
  while [ $grew = 1 ]; do
    grew=0
    while IFS=/ read -r k n; do
      case "$k" in s|a) ;; *) continue ;; esac
      f=$(artifact_file "$src" "$k" "$n")
      for dk in skills agents tools; do
        case "$dk" in skills) l=s ;; agents) l=a ;; tools) l=t ;; esac
        for ref in $(artifact_deps "$f" "$k" "$dk"); do
          [ "$l" = t ] && continue                 # tools lay unfiltered today
          case "$ref" in
            */*) echo "$l ${ref##*/} $k/$n ${ref%%/*}" >> "$XDEPS" ;;
            *)
              dn=$ref
              if [ -e "$(artifact_file "$src" "$l" "$dn")" ]; then
                if ! grep -qx "$l/$dn" "$SEL_FILE"; then
                  sel_add "$l" "$dn"
                  say "  closure: +$l/$dn (needed by $k/$n)"
                  grew=1
                fi
              else
                say "  WARN $id: $k/$n depends on $l/$dn, absent from this package"
              fi ;;
          esac
        done
      done
    done < "$SEL_FILE"
  done
}

build_selection() { # build_selection <root> <src> <id>
  local root=$1 src=$2 id=$3 entries e k n f decl
  SEL_ACTIVE=0; : > "$SEL_FILE"
  entries=$(dep_include "$root" "$id")
  [ -n "$entries" ] || return 0
  SEL_ACTIVE=1
  while read -r k n; do
    [ -n "$k" ] || continue
    f=$(artifact_file "$src" "$k" "$n")
    decl=$(artifact_categories "$f")
    [ -z "$decl" ] && sel_add "$k" "$n"          # undeclared always lays
  done < <(each_artifact "$src")
  for e in $entries; do
    leaf_pick "$src" "$e" && continue
    while read -r k n; do
      [ -n "$k" ] || continue
      f=$(artifact_file "$src" "$k" "$n")
      decl=$(artifact_categories "$f")
      [ -n "$decl" ] && cat_hit "$decl" "$e" && sel_add "$k" "$n"
    done < <(each_artifact "$src")
  done
  close_selection "$src" "$id"
}

resolve_xdeps() { # cross-package closure by the name-rooted grammar (one level)
  local root=$1 l n needer pkg id origin raw src found
  [ -s "$XDEPS" ] || return 0
  sort -u -o "$XDEPS" "$XDEPS"
  while read -r l n needer pkg; do
    [ -n "$l" ] || continue
    found=""
    while read -r id origin raw; do
      [ -n "$id" ] || continue
      src=$(source_tree "$root" "$id")
      [ "$(pkg_namespace "$src" "$id")" = "$pkg" ] || continue
      [ -e "$(artifact_file "$src" "$l" "$n")" ] || [ -e "$src/tools/$n" ] && { found=$id; break; }
    done < <(deps_list "$root")
    if [ -n "$found" ]; then
      lay_one_artifact "$root" "$found" "$l" "$n"
      say "  closure: +$pkg/$l/$n (needed by $needer)"
    else
      say "  WARN: $needer depends on $pkg/…/$n, and no installed source is the package \"$pkg\""
    fi
  done < "$XDEPS"
  : > "$XDEPS"
}

lay_one_artifact() { # lay_one_artifact <root> <id> <kind-letter> <name>
  local root=$1 id=$2 l=$3 n=$4 src mode ns t dstdir
  src=$(source_tree "$root" "$id"); mode=$(publish_mode "$root" "$id"); ns=$(pkg_namespace "$src" "$id")
  case "$l" in
    s) t="$src/skills/$n";    dstdir="$root/.claude/skills" ;;
    a) t="$src/agents/$n.md"; dstdir="$root/.claude/agents"; n="$n.md" ;;
    t) t="$src/tools/$n";     dstdir="$root/.claude/tools" ;;
  esac
  mkdir -p "$dstdir"
  if [ "$mode" = copy ]; then NS_DST="$n"; else namespace_for "$dstdir" "$n" "$ns"; fi
  place_one "$mode" "$t" "$dstdir/$NS_DST" && LAID=$((LAID+1))
}

render_tree() { # render_tree <root> <id> — the derived tree, for the add-time conversation
  local root=$1 id=$2 src k n f decl c
  src=$(source_tree "$root" "$id")
  { while read -r k n; do
      [ -n "$k" ] || continue
      f=$(artifact_file "$src" "$k" "$n")
      decl=$(artifact_categories "$f")
      if [ -n "$decl" ]; then while IFS= read -r c; do echo "$c $k/$n"; done <<< "$decl"
      else echo "(uncategorised) $k/$n"; fi
    done < <(each_artifact "$src")
  } | sort | awk '{ if($1!=p){ printf "%s%s:", (NR>1?"\n":""), $1; p=$1 } printf " %s", $2 } END { print "" }'
}

offer_tree() { # after an install with no include list: show the tree, invite one
  local root=$1 id=$2 raw
  [ -z "$(dep_include "$root" "$id")" ] || return 0
  raw=$(dep_source "$root" "$id")
  say ""
  say "$id declares this tree; nothing is selected, so everything installed."
  render_tree "$root" "$id" | sed 's/^/  /'
  say "To trim, add to the [[dependency]] with source = \"$raw\" in .ai.toml:  include = [\"<category-path>\", …]"
}

# ---------- runtime detection ----------
detect_runtimes() { # -> a SET, one name per line (Decision-018)
  local root=$1
  { [ -d "$root/.claude" ] || [ -f "$root/CLAUDE.md" ]; } && echo claude
  return 0
}

# ---------- layout ----------
LAID=0

place_one() { case "$1" in copy) copy_one "$2" "$3" ;; *) link_one "$2" "$3" ;; esac; }

NS_LOCAL="local"
NS_SEP=":"
NS_DST=""

namespace_for() { # a name collision keeps both, namespaced (Decision-042)
  local dstdir=$1 n=$2 ns=$3
  if [ -e "$dstdir/$NS_LOCAL$NS_SEP$n" ]; then NS_DST="$ns$NS_SEP$n"; return 0; fi
  if [ -e "$dstdir/$n" ] && [ ! -L "$dstdir/$n" ]; then
    mv "$dstdir/$n" "$dstdir/$NS_LOCAL$NS_SEP$n"
    say "  NAMESPACED $NS_LOCAL$NS_SEP$n (yours) and $ns$NS_SEP$n (package) — same name, different things"
    NS_DST="$ns$NS_SEP$n"; return 0
  fi
  NS_DST="$n"
}

lay_kind() { # lay_kind <mode> <src-dir> <dst-dir> <glob-suffix> <pkgns> <kind-letter>
  local mode=$1 srcdir=$2 dstdir=$3 ns=$5 kind=${6:-} t n
  [ -d "$srcdir" ] || return 0
  mkdir -p "$dstdir"
  for t in "$srcdir"/*$4; do
    [ -e "$t" ] || continue
    n=$(basename "$t")
    case "$n" in .*|__pycache__|*"$NS_SEP"*) continue ;; esac
    [ -n "$kind" ] && ! sel_allows "$kind" "$(basename "$n" .md)" && continue
    if [ "$mode" = copy ]; then NS_DST="$n"; else namespace_for "$dstdir" "$n" "$ns"; fi
    place_one "$mode" "$t" "$dstdir/$NS_DST" && LAID=$((LAID+1))
  done
}

lay_claude() { # lay_claude <root> <src> <mode> <pkgns>
  local root=$1 src=$2 mode=$3 ns=$4
  NS_SEP=":"
  lay_kind "$mode" "$src/skills" "$root/.claude/skills" ""    "$ns" s
  lay_kind "$mode" "$src/agents" "$root/.claude/agents" ".md" "$ns" a
  lay_kind "$mode" "$src/hooks"  "$root/.claude/hooks"  ""    "$ns"
  lay_kind "$mode" "$src/tools"  "$root/.claude/tools"  ""    "$ns"
}

# EXACTLY ONE SETTINGS JSON EXISTS, AND IT IS PASSED, NEVER LAID (Decision-061).
# It rides `claude --settings` at spawn, from beside the kai binary. A package
# may still carry one in its files/ tree — an old one does — and kai refuses it
# whatever arrives, rather than trusting every package to have stopped.
never_laid() {
  case "$1" in
    .claude/settings.json|.claude/settings.local.json) return 0 ;;
    *) return 1 ;;
  esac
}

lay_files() { # files/<path> -> <root>/<path>, verbatim (Decision-015)
  local root=$1 src=$2 mode=$3 rel
  [ -d "$src/files" ] || return 0
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if never_laid "$rel"; then
      say "  REFUSED $rel (a settings JSON is passed at spawn, never laid — Decision-061)"
      continue
    fi
    mkdir -p "$root/$(dirname "$rel")"
    place_one "$mode" "$src/files/$rel" "$root/$rel" && LAID=$((LAID+1))
  done < <(cd "$src/files" && find . -type f 2>/dev/null | sed 's|^\./||')
}

lay_source() { # lay_source <root> <id>  (idempotent; never destroys real files)
  local root=$1 id=$2 src mode rt runtimes ns
  src=$(source_tree "$root" "$id")
  is_package "$src" || { say "$id: no package contents — nothing to lay"; return 0; }
  mode=$(publish_mode "$root" "$id")
  ns=$(pkg_namespace "$src" "$id")

  runtimes=$(detect_runtimes "$root")
  if [ -z "$runtimes" ]; then
    say "$id: no agent runtime detected here — nothing laid"
    say "  (a repository is a Claude repository when it has .claude/ or CLAUDE.md)"
    return 0
  fi

  LAID=0
  build_selection "$root" "$src" "$id"
  for rt in $runtimes; do
    case "$rt" in
      claude) lay_claude "$root" "$src" "$mode" "$ns" ;;
      *)      say "  WARN $id: no renderer for runtime '$rt'" ;;
    esac
  done
  lay_files "$root" "$src" "$mode"
  prune_deselected "$root" "$src"
  SEL_ACTIVE=0
  say "$mode: $LAID laid/verified ($id) [$(echo "$runtimes" | tr '\n' ' ')]"
}

lay_self() { # lay_self <root> — root-table type = "package": this repository is
             # also a consumer of ITS OWN migrations/agents/skills/files, laid
             # by copy rather than link (there is no clone to link through).
             # Unfiltered: self has no [[dependency]] include list to key off.
  local root=$1 ns rt runtimes
  is_package "$root" || { say "self: no package contents at root — nothing to lay"; return 0; }
  ns=$(pkg_namespace "$root" "$(path_id "$root")")
  runtimes=$(detect_runtimes "$root")
  if [ -z "$runtimes" ]; then
    say "self: no agent runtime detected here — nothing laid"
    return 0
  fi
  LAID=0
  for rt in $runtimes; do
    case "$rt" in
      claude) lay_claude "$root" "$root" copy "$ns" ;;
      *)      say "  WARN self: no renderer for runtime '$rt'" ;;
    esac
  done
  lay_files "$root" "$root" copy
  say "copy: $LAID laid/verified (self) [$(echo "$runtimes" | tr '\n' ' ')]"
}

lexical_abs() { # lexical_abs <base-dir> <path> -> absolute, ".." collapsed as text
                # Deliberately textual: it must NOT follow symlinks, because the
                # store itself is reached through one and resolving that would
                # answer with the git folder rather than the package path being
                # compared against.
  local p=$2
  case "$p" in /*) ;; *) p="$1/$p" ;; esac
  printf '%s\n' "$p" | awk -F/ '{
    n = 0
    for (i = 1; i <= NF; i++) {
      if ($i == "" || $i == ".") continue
      if ($i == "..") { if (n > 0) n--; continue }
      out[++n] = $i
    }
    s = ""
    for (i = 1; i <= n; i++) s = s "/" out[i]
    print (s == "" ? "/" : s)
  }'
}

prune_deselected() { # a link whose artifact fell out of the selection is removed
  [ "$SEL_ACTIVE" = 1 ] || return 0
  local root=$1 src=$2 l t k n
  for l in "$root"/.claude/skills/* "$root"/.claude/agents/*; do
    [ -L "$l" ] || continue
    # laid links are relative, so the raw target is resolved against the link's
    # own directory before it can be matched against the package it came from
    t=$(lexical_abs "$(dirname "$l")" "$(readlink "$l")")
    case "$t" in
      "$src"/skills/*) k=s; n=${t#"$src"/skills/}; n=${n%%/*} ;;
      "$src"/agents/*) k=a; n=$(basename "$t" .md) ;;
      *) continue ;;
    esac
    sel_allows "$k" "$n" || { rm "$l"; say "  DESELECT ${l#"$root"/} (outside the selection)"; }
  done
}

CONFLICTS=""

# A laid link is COMMITTED, so its target has to be right in every checkout of
# the repository, not just the one that laid it. An absolute target names the
# machine that wrote it and is wrong everywhere else; a target counted from the
# process working directory is wrong whenever the two differ, which is what put
# five-step targets into links that needed two. The count is therefore taken
# from the nearest .ai.toml at or above the link — the one landmark that sits at
# a fixed place in a repository whichever checkout you are in.

anchor_of() { # anchor_of <dir> -> nearest directory at or above it holding .ai.toml
  local d=$1
  while [ -n "$d" ] && [ "$d" != / ] && [ "$d" != . ]; do
    [ -f "$d/.ai.toml" ] && { printf '%s\n' "$d"; return 0; }
    d=$(dirname "$d")
  done
  return 1
}

rel_target() { # rel_target <abs-target> <linkpath> -> target as the link should carry it
               # Falls back to the absolute path when there is no anchor to count
               # from, or when the target lies outside it — a working link beats a
               # relative one that cannot be derived honestly.
  local target=$1 link=$2 anchor linkdir rest depth prefix="" i=0
  linkdir=$(dirname "$link")
  anchor=$(anchor_of "$linkdir") || { printf '%s\n' "$target"; return 0; }
  case "$target" in "$anchor"/*) rest=${target#"$anchor"/} ;; *) printf '%s\n' "$target"; return 0 ;; esac
  case "$linkdir" in
    "$anchor")   depth=0 ;;
    "$anchor"/*) depth=$(printf '%s' "${linkdir#"$anchor"/}" | awk -F/ '{print NF}') ;;
    *)           printf '%s\n' "$target"; return 0 ;;
  esac
  while [ "$i" -lt "$depth" ]; do prefix="../$prefix"; i=$((i + 1)); done
  printf '%s\n' "$prefix$rest"
}

link_one() { # link_one <abs-target> <linkpath> -> 0 correct, 1 blocked
  local target=$1 link=$2 want
  [ -e "$target" ] || { say "  SKIP $link (target missing in package)"; return 1; }
  want=$(rel_target "$target" "$link")
  if [ -L "$link" ]; then
    [ "$(readlink "$link")" = "$want" ] || ln -sfn "$want" "$link"
    return 0
  fi
  if [ -e "$link" ]; then
    say "  BLOCKED $link (a real file is already there — kai did not place it, so kai will not touch it)"
    CONFLICTS="$CONFLICTS$link|$target"$'\n'
    return 1
  fi
  ln -s "$want" "$link"
}

report_conflicts() { # invite the user to decide — never decide for them (Decision-041)
  [ -n "$CONFLICTS" ] || return 0
  local n; n=$(printf '%s' "$CONFLICTS" | grep -c . || true)
  say ""
  say "$n destination(s) already hold a file kai did not place. Nothing was changed."
  say "kai cannot tell which version you intended, so it will not choose. You can:"
  say "  kai resolve            list them with the package version alongside"
  say "  kai resolve --assist   ask Claude to attempt a merge, under the usual gates"
  say "  (or merge them yourself — that is always the fallback)"
}

copy_one() { # self-published packages copy into their own repo
  local src=$1 dst=$2
  [ -e "$src" ] || { say "  SKIP $dst (missing in package)"; return 1; }
  case "$dst" in */.claude/*|"$PWD"/*) ;; *) die "refusing to write outside a published destination: $dst" ;; esac
  [ -L "$dst" ] && rm "$dst"
  if [ -d "$src" ]; then
    [ -d "$dst" ] && diff -rq "$src" "$dst" >/dev/null 2>&1 && return 0
    rm -rf "${dst:?}"; cp -r "$src" "$dst"; return 0
  fi
  cmp -s "$src" "$dst" 2>/dev/null && return 0
  cp "$src" "$dst"
}

prune_links() { # dead symlinks into this repo's .ai/repositories/: repoint if the tail moved to exactly one cloned source; tracked debris is reported, only untracked true orphans are pruned
  local root=$1 l target rel rest d candidate matches n
  while IFS= read -r l; do
    [ -e "$l" ] && continue
    # match the target STRING anywhere it mentions the store: hand-laid links
    # have been found relative, and relative against the wrong base — a dead
    # link naming .ai/repositories/ is a store link whatever its base claims,
    # and the repoint below rewrites it through rel_target, healing a wrong
    # base along with a moved tail
    target=$(readlink "$l")
    case "$target" in
      *".ai/repositories/"*) ;;
      *) continue ;;
    esac
    rel=${target##*".ai/repositories/"}
    rel=${rel#/}
    case "$rel" in
      */*/*) rest=${rel#*/}; rest=${rest#*/} ;;
      *) continue ;; # not <owner>/<repo>/<tail> — nothing to derive
    esac
    matches="" n=0
    for d in "$root"/.ai/repositories/*/*/; do
      [ -d "${d}.git" ] || continue
      candidate="${d%/}/$rest"
      [ -e "$candidate" ] || continue
      matches=$candidate n=$((n + 1))
    done
    case $n in
      0)
        if git -C "$root" ls-files --error-unmatch "${l#"$root"/}" >/dev/null 2>&1; then
          say "  DEBRIS ${l#"$root"/} (tracked dangling link, no source carries its tail — removal is the operator's call)"
        else
          rm "$l"; say "  PRUNE ${l#"$root"/} (target gone from package)"
        fi ;;
      1) ln -sfn "$(rel_target "$matches" "$l")" "$l"; say "  RELINK ${l#"$root"/} -> ${matches#"$root"/}" ;;
      *) say "  AMBIGUOUS ${l#"$root"/} ($n sources carry $rest — kai will not guess)" ;;
    esac
  done < <(find "$root" \( -name .git -o -name .ai \) -prune -o -type l -print 2>/dev/null)
}

ensure_gitignore() {
  local root=$1
  grep -qx '\.ai/repositories/' "$root/.gitignore" 2>/dev/null || printf '.ai/repositories/\n' >> "$root/.gitignore"
}

# ---------- migrations ----------
pkg_artifact_names() { # pkg_artifact_names <src> -> kind/name per line, sorted
  local src=$1 t
  { for t in "$src"/skills/*/; do [ -e "$t" ] && echo "s/$(basename "$t")"; done
    for t in "$src"/agents/*.md; do [ -e "$t" ] && echo "a/$(basename "$t" .md)"; done
    for t in "$src"/hooks/* "$src"/tools/*; do [ -e "$t" ] && echo "x/$(basename "$t")"; done
    :
  } 2>/dev/null | sort
}

# ONE global watermark (Decision, 2026-08-19): the <YYYY-MM-DD>-<NN> prefix of
# the last applied migration, one committed line at .ai/migrations.toml under
# [migrations] — never per source, never under .git (nothing survives a clone
# there). Every declared source's migrations/, plus this repository's own when
# root-table type = "package", merge into ONE stream ordered by that prefix;
# packages no longer migrate independently of each other. Errors are reported,
# not handled: a failing scripted step is reported and kai moves on to the
# next migration — no ask files, no blocking, no hand-off to an agent.
WATERMARK_FILE=".ai/migrations.toml"

mig_date() { local b; b=$(basename "$1" .md); printf '%s\n' "${b:0:10}"; }

mig_nn() { # mig_nn <path> -> the NN token as an integer; 0 for the older
           # <YYYY-MM-DD>-<slug>.md form, which has no NN to read
  local b rest nn
  b=$(basename "$1" .md); rest=${b:11}; nn=${rest%%-*}
  case "$nn" in ''|*[!0-9]*) nn=0 ;; esac
  printf '%d\n' "$((10#$nn))"
}

collect_migrations() { # collect_migrations <root> -> "<date> <nn> <id> <path>"
                        # per line, one global stream sorted by date then NN.
                        # Every package ON DISK contributes, read from the store
                        # itself rather than from .ai.toml: what a repository has
                        # already been given is a fact of the store, and a
                        # migration must still reach it while the file that
                        # declares it is mid-conversion.
  local root=$1 d id f
  { for d in "$root"/.ai/repositories/*/*/; do
      [ -d "${d}migrations" ] || continue
      id=${d#"$root/.ai/repositories/"}; id=${id%/}
      for f in "${d}migrations"/*.md; do
        [ -e "$f" ] || continue
        printf '%s %s %s %s\n' "$(mig_date "$f")" "$(mig_nn "$f")" "$id" "$f"
      done
    done
    if is_package_repo "$root" && [ -d "$root/migrations" ]; then
      for f in "$root"/migrations/*.md; do
        [ -e "$f" ] || continue
        printf '%s %s %s %s\n' "$(mig_date "$f")" "$(mig_nn "$f")" "(self)" "$f"
      done
    fi
  } | sort -k1,1 -k2,2n
}

lock_watermark() { # lock_watermark <root> -> the stored prefix, or "" (absent = fresh install)
  local f="$1/$WATERMARK_FILE"
  [ -f "$f" ] || return 0
  awk '
    /^\[migrations\]/ { cur=1; next }
    /^\[/               { cur=0 }
    cur && /^watermark[ \t]*=/ { n=split($0,a,"\""); if (n>=2) print a[2] }
  ' "$f"
}

write_watermark() { # write_watermark <root> <prefix> — .ai/migrations.toml is
                     # generated state, not the operator's to hand-edit;
                     # regenerated whole, and carrying no name but the value's.
  local root=$1 val=$2 f="$root/$WATERMARK_FILE"
  mkdir -p "$(dirname "$f")"
  cat > "$f" <<EOF
[migrations]
watermark = "$val"
EOF
}

next_migration() { # next_migration <root> <watermark> <already-applied-file>
                    # -> the one line of the stream that comes straight after
                    # the watermark and has not already run in this pass
  local root=$1 wm=$2 done_file=$3 wm_date wm_nn
  if [ -z "$wm" ]; then
    wm_date=""; wm_nn=0
  else
    wm_date=${wm%-*}; wm_nn=${wm##*-}
    case "$wm_nn" in ''|*[!0-9]*) wm_date=$wm; wm_nn=0 ;; esac
  fi
  # The older <date>-<slug> filenames all carry NN 0, so several migrations can
  # share one watermark prefix and the prefix alone cannot say which of them has
  # run. The watermark therefore does NOT move during a pass: it is what the
  # repository had on entry, and the basenames already applied in this pass are
  # remembered separately. Both are needed — the prefix to know where the
  # repository stood, the list to sequence within the pass.
  collect_migrations "$root" | awk -v wd="$wm_date" -v wn="$wm_nn" -v df="$done_file" '
    BEGIN { while ((getline l < df) > 0) ran[l] = 1 }
    {
      b = $4; sub(/.*\//, "", b); sub(/\.md$/, "", b)
      if (b in ran) next
      if (wd == "")  { print; exit }
      if ($1 == wd)  { if ($2 + 0 > wn + 0) { print; exit } ; next }
      if ($1 > wd)   { print; exit }
    }
  '
}

apply_pending_migrations() { # apply_pending_migrations <root> — the merged engine
  local root=$1 wm line d nn id path base done_file highest=""
  done_file=$(mktemp); trap 'rm -f "$done_file"' RETURN
  # NO WATERMARK MEANS EVERY MIGRATION IS PENDING (operator, 2026-08-26).
  # Absence is the marker; nothing is written to stand in for it and no date is
  # invented. Each migration then detects for itself whether it still applies —
  # that is what the detect step of the format is for. The marker gets its real
  # value at install (see stamp_install_watermark) and advances from there.
  wm=$(lock_watermark "$root")
  [ -n "$wm" ] || say "migrations: no watermark here — every migration is pending, each detects for itself"

  # ONE AT A TIME, RE-READING THE STREAM EACH TIME. A migration is free to move
  # the store — the kaukea rename does exactly that — and every path collected
  # before it ran points at where the clone used to be. So the next migration is
  # located when its turn comes, never up front. The watermark advances after
  # each one, failure included (errors are reported, not handled), so an
  # interrupted run resumes where it stopped rather than starting over.
  while :; do
    line=$(next_migration "$root" "$wm" "$done_file")
    [ -n "$line" ] || break
    d=${line%% *}; line=${line#* }
    nn=${line%% *}; line=${line#* }
    id=${line%% *}; path=${line#* }
    base=$(basename "$path" .md)
    if [ ! -f "$path" ]; then
      say "  migration $base ($id): its file is gone from the store — skipped"
    else
      say "  migration $base ($id): running scripted steps"
      if awk '/^```sh$/{b=1;next} /^```/{b=0} b' "$path" | (cd "$root" && bash); then
        say "  migration $base: applied"
      else
        say "  migration $base: FAILED — reported; kai moves on"
      fi
    fi
    printf '%s\n' "$base" >> "$done_file"
    highest="$d-$nn"
  done
  [ -n "$highest" ] && write_watermark "$root" "$highest"
  return 0
}

stamp_install_watermark() { # a repository installed TODAY does not replay history:
                             # the marker is the install date. Only ever written
                             # when there is none — never over a real one.
  local root=$1
  [ -n "$(lock_watermark "$root")" ] && return 0
  write_watermark "$root" "$(date +%F)-0"
  say "migrations: watermark set to the install date"
}

announce_reload() { # unconditional at the end of every sync, package or not
                     # (Decision, 2026-08-19): an agent is reloaded by
                     # reloading its session, which is what picks up
                     # definitions kai just laid or migrated. kai has no way
                     # to force an interactive session to do that from a bash
                     # process — it can only say so, plainly, every time.
  say "reload: this session's agents/skills may now be stale — reload the session (exit and resume it, or start a new one) to pick up what sync just laid"
}

# ---------- package dependencies ----------
# A package that needs ANOTHER package used to say so in package.toml. That file
# is gone and where the declaration goes instead is PARKED with the versioning
# work (operator, 2026-08-26), so nothing is installed on a package's behalf
# today: a consumer declares every package it wants in its own .ai.toml.

# ---------- install ----------
install_source() { # install_source <root> <tablekey-or-id> — register, clone, lay
  local root=$1 ref=$2 id origin clone src bare
  bare=$(strip_ref "$ref")
  case "$bare" in
    *://*|git@*) register_dependency "$root" "$ref"; id=$(uri_id "$bare") ;;
    /*|./*|../*) register_dependency "$root" "$ref"; id=$(path_id "$(abs_path "$root" "$bare")") ;;
    */*)         register_dependency "$root" "$ref"; id=$bare ;;
    *) say "  WARN install: '$ref' is not <owner>/<repo>, a git URI, or a path"; return 1 ;;
  esac
  origin=$(dep_origin "$root" "$id")
  clone=$(clone_of "$root" "$id")
  if [ ! -d "$clone/.git" ]; then
    mkdir -p "$(dirname "$clone")"
    git clone --quiet "$origin" "$clone" 2>/dev/null || { say "  WARN $id: clone failed from $origin"; return 1; }
    say "clone: $clone"
  else
    say "clone: already present"
  fi
  src="$clone"
  [ -d "$origin/.git" ] && git -C "$origin" config receive.denyCurrentBranch updateInstead || true
  is_package "$src" || { say "  WARN $id has no package contents — not a kai package (expects any of: $KINDS)"; return 1; }

  # A destination the user owns is REPORTED AND SKIPPED (Decision-016); a name
  # collision is namespaced (Decision-042); nothing is dispatched (Decision-041).
  lay_source "$root" "$id"
}

cmd_install() {
  local ref=${1:-}
  [ -n "$ref" ] || die "usage: kai install <owner>/<repo> | <uri> | <path>"
  local root; root=$(repo_root)
  ensure_aitoml "$root"
  validate_config "$root"
  ensure_gitignore "$root"
  stamp_install_watermark "$root"
  install_source "$root" "$ref" || die "install: $ref failed"
  resolve_xdeps "$root"
  prune_links "$root"
  local id bare; bare=$(strip_ref "$ref")
  case "$bare" in
    *://*|git@*) id=$(uri_id "$bare") ;;
    /*|./*|../*) id=$(path_id "$(abs_path "$root" "$bare")") ;;
    *)           id=$bare ;;
  esac
  say "install: $id done"
  offer_tree "$root" "$id"
  report_conflicts
}

# ---------- resolve ----------
collect_conflicts() {
  local root=$1 id origin raw
  CONFLICTS=""
  while read -r id origin raw; do
    [ -n "$id" ] || continue
    lay_source "$root" "$id" >/dev/null
  done < <(deps_list "$root")
}

cmd_resolve() {
  local root; root=$(repo_root)
  validate_config "$root"
  local assist=0
  [ "${1:-}" = "--assist" ] && assist=1
  collect_conflicts "$root"
  [ -n "$CONFLICTS" ] || { say "resolve: nothing to resolve — no destination holds a file kai did not place"; return 0; }

  local link target list=""
  while IFS='|' read -r link target; do
    [ -n "$link" ] || continue
    say "  ${link#"$root"/}"
    say "      yours:   $link"
    say "      package: $target"
    list="$list ${link#"$root"/}"
  done < <(printf '%s' "$CONFLICTS")

  if [ $assist = 0 ]; then
    say ""
    say "Merge them yourself, or run 'kai resolve --assist' to have Claude attempt it."
    return 0
  fi

  command -v claude >/dev/null 2>&1 || die "claude is not on PATH — merge these yourself"
  say ""
  say "Attempting an assisted merge for:$list"
  say "It follows the normal gates: it proposes, you approve, nothing is committed."
  claude -p "You are in the git repository $root. These paths each hold a file the user owns, and a package wants to provide its own version at the same path:$list. For EACH: read the user's file, read the package version (the path is printed above as 'package:'), and judge whether a SIMPLE, unambiguous merge exists — one that loses nothing the user wrote. If it does, show the proposed result and explain it. If it does not, say so plainly and stop: the user resolves it themselves. Change nothing on disk. Commit nothing." --output-format text \
    || say "assisted merge did not complete — resolve these yourself"
}

# ---------- init ----------
cmd_init() {
  local root; root=$(repo_root)
  local script_repo
  ensure_aitoml "$root"
  ensure_gitignore "$root"
  stamp_install_watermark "$root"
  script_repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
  if same_path "$script_repo" "$root"; then
    lay_self "$root"
    prune_links "$root"
    say "init: done — this repository is itself the kai package (self-published; put type = \"package\" in the root table of .ai.toml to also apply its own migrations on sync)"
    return 0
  fi
  install_source "$root" "${KAUK_ORIGIN:-$script_repo}" || true
  prune_links "$root"
  say "init: done — add a data package with 'kai install <owner>/<repo> | <path>'"
}

# ---------- sync ----------
# Bare sync converges to the pin and notifies. --pull takes updates; --push
# publishes local edits. Rebase is the default; a conflict stops and reports
# (Decision-050). Migrations run at --pull (Decision-022/043).
commit_local_edits() { # preserve uncommitted clone edits so the rebase carries them
  local clone=$1
  [ -n "$(git -C "$clone" status --porcelain)" ] || return 0
  git -C "$clone" add -A
  git -C "$clone" commit --quiet -m "🔁 local edits, preserved for rebase"
}

rebase_onto() { # rebase_onto <id> <clone> <target> -> 0 ok; 1 conflict (aborted, reported)
  local id=$1 clone=$2 target=$3
  git -C "$clone" rebase --quiet "$target" 2>/dev/null && return 0
  git -C "$clone" rebase --abort 2>/dev/null || true
  say "$id: rebase onto $target CONFLICTS — nothing changed; the merge storyline is yours (clone: $clone)"
  return 1
}

sync_source() { # sync_source <root> <id> <pull:0|1> <push:0|1>
  local root=$1 id=$2 pull=$3 push=$4 clone origin target before after gone ref
  clone=$(clone_of "$root" "$id")
  if [ ! -d "$clone/.git" ]; then
    origin=$(dep_origin "$root" "$id")
    [ -n "$origin" ] || { say "$id: no origin for this package — skipped"; return 0; }
    mkdir -p "$(dirname "$clone")"
    git clone --quiet "$origin" "$clone" 2>/dev/null || { say "$id: clone failed from $origin (offline?)"; return 0; }
    say "clone: $clone"
    [ -d "$origin/.git" ] && git -C "$origin" config receive.denyCurrentBranch updateInstead || true
  fi

  # @HEAD is the only ref acted on: a branch, tag or commit waits for the
  # versioning work (operator, 2026-08-26), and until then its clone is left
  # exactly where it is and what is there is laid.
  ref=$(dep_ref "$root" "$id")
  if [ -n "$ref" ] && [ "$ref" != HEAD ]; then
    say "$id: source names @$ref — anything other than @HEAD waits for the versioning work; laying what is there, moving nothing"
    lay_source "$root" "$id"
    return 0
  fi

  git -C "$clone" fetch --quiet origin 2>/dev/null || true
  target=main
  git -C "$clone" rev-parse --verify --quiet origin/main >/dev/null && target=origin/main

  before=$(pkg_artifact_names "$clone")
  commit_local_edits "$clone"
  if ! rebase_onto "$id" "$clone" "$target"; then
    lay_source "$root" "$id"
    return 0
  fi
  after=$(pkg_artifact_names "$clone")
  gone=$(comm -23 <(echo "$before") <(echo "$after") | grep . || true)
  if [ -n "$gone" ]; then
    say "  WARN $id: this sync removes or renames artifacts a running session may still hold:"
    echo "$gone" | sed 's/^/    /'
  fi

  if [ "$push" = 1 ]; then
    if git -C "$clone" push --quiet origin "HEAD:main" 2>/dev/null; then
      say "push: $id → $(git -C "$clone" rev-parse --short HEAD) published"
    else
      say "$id: push failed (offline, or no write access) — your edits stay committed in the clone"
    fi
  fi

  lay_source "$root" "$id"
  say "sync: $id ($(git -C "$clone" rev-parse --short HEAD))"
}

sweep_orphan_clones() { # clones under .ai/repositories/ that .ai.toml no longer declares: removed only when provably disposable, else reported
  local root=$1 d id keep head
  [ -d "$root/.ai/repositories" ] || return 0
  keep=$(deps_list "$root" | awk '{print $1}')
  # A clone is not undeclared when the declarations could not be READ. An
  # .ai.toml still in a form kai does not parse yields nothing, and sweeping on
  # that would delete the whole store — including the very package carrying the
  # migration that converts the file. Absent information is not evidence.
  if [ -z "$keep" ]; then
    say "  sweep skipped: .ai.toml declares nothing readable, so nothing here can be called undeclared"
    return 0
  fi
  for d in "$root"/.ai/repositories/*/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    id=${d#"$root/.ai/repositories/"}
    printf '%s\n' "$keep" | grep -qx "$id" && continue
    if [ ! -d "$d/.git" ]; then
      say "  ORPHAN $id: undeclared and not a clone (no .git) — left in place for the operator"
      continue
    fi
    if [ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ]; then
      say "  ORPHAN $id: undeclared but carries uncommitted changes — kept"
      continue
    fi
    head=$(git -C "$d" rev-parse HEAD 2>/dev/null) || { say "  ORPHAN $id: undeclared, unreadable HEAD — kept"; continue; }
    git -C "$d" fetch --quiet origin 2>/dev/null || true
    if [ -n "$(git -C "$d" branch -r --contains "$head" 2>/dev/null)" ]; then
      rm -rf "$d"
      rmdir "$(dirname "$d")" 2>/dev/null || true
      say "  SWEEP $id: undeclared clone removed (clean, contained in its origin)"
    else
      say "  ORPHAN $id: undeclared, but its head is not on any origin ref — kept"
    fi
  done
}

status_source() { # status_source <root> <id>
  local root=$1 id=$2 clone dirty ahead behind
  clone=$(clone_of "$root" "$id")
  [ -d "$clone/.git" ] || { say "$id: no clone"; return 0; }
  git -C "$clone" fetch --quiet origin 2>/dev/null || { say "$id: fetch failed (offline?)"; return 0; }
  dirty=$(git -C "$clone" status --porcelain | wc -l)
  ahead=$(git -C "$clone" rev-list --count origin/main..HEAD)
  behind=$(git -C "$clone" rev-list --count HEAD..origin/main)
  say "$id: $behind incoming · $ahead outgoing · $dirty uncommitted local edit(s)"
  lay_source "$root" "$id"
}

cmd_sync() {
  local root; root=$(repo_root)
  validate_config "$root"
  local status_only=0 pull=0 push=0 a
  for a in "$@"; do
    case "$a" in
      --status) status_only=1 ;;
      --pull)   pull=1 ;;
      --push)   push=1 ;;
      *) die "usage: kai sync [--status | --pull | --push]" ;;
    esac
  done
  [ "$pull" = 1 ] && [ "$push" = 1 ] && die "one of --pull or --push — taking and giving are separate acts"
  # Apply what was already pending BEFORE anything is read or fetched
  # (docs/package-format.md: apply what was already pending -> rebase -> apply
  # what arrived). A migration that rewrites .ai.toml has therefore already run
  # by the time .ai.toml is read.
  [ $status_only = 1 ] || apply_pending_migrations "$root"

  local list; list=$(sync_list "$root")
  local self=0; is_package_repo "$root" && self=1

  # A package repository is also a consumer of ITS OWN migrations (Decision,
  # 2026-08-19) — declaring no dependencies of its own is no longer a dead end.
  [ -n "$list" ] || [ "$self" = 1 ] || die "no dependencies in .ai.toml — run 'kai init' first"
  local id origin raw
  while read -r id origin raw; do
    [ -n "$id" ] || continue
    if [ $status_only = 1 ]; then status_source "$root" "$id"; else sync_source "$root" "$id" "$pull" "$push"; fi
  done < <(printf '%s\n' "$list")
  if [ "$self" = 1 ] && [ $status_only = 0 ]; then lay_self "$root"; fi
  [ $status_only = 1 ] || apply_pending_migrations "$root"
  [ $status_only = 1 ] || sweep_orphan_clones "$root"
  [ $status_only = 1 ] || resolve_xdeps "$root"
  prune_links "$root"
  report_conflicts
  [ $status_only = 1 ] || announce_reload
}

main() {
  SEL_FILE=$(mktemp); XDEPS=$(mktemp)
  trap 'rm -f "$SEL_FILE" "$XDEPS"' EXIT
  case "${1:-}" in
    init)    shift; cmd_init "$@" ;;
    install) shift; cmd_install "$@" ;;
    sync)    shift; cmd_sync "$@" ;;
    resolve) shift; cmd_resolve "$@" ;;
    *) die "usage: kai init | install <owner>/<repo> | <path> | sync [--status|--pull|--push] | resolve [--assist]" ;;
  esac
}
main "$@"
