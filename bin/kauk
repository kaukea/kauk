#!/usr/bin/env bash
# kauk — stopgap distribution of file packages (skills, agents, shared rule
# files) for AI-agent-driven repositories. The real `kauk` CLI ships at 0.1.0 and
# inherits this grammar; until then this bash MVP dies gracefully: delete .ai/ and
# the symlinks, nothing else breaks.
#
#   kauk init                               bootstrap THIS repo (no data source)
#   kauk install <owner>/<repo> [<origin>]  vendor + lay a data package
#   kauk sync [--status]                    converge every installed source to the lock
#   kauk update [<owner>/<repo>]            move the pin: fetch (tags too), re-lock,
#                                           run pending migrations, warn on removals
#   kauk resolve [--assist]                 list destinations kauk refused to touch;
#                                           --assist asks Claude to attempt a merge
#
# Sources are recorded in .ai.toml ([sources."<owner>/<repo>"] origin = "URL|path");
# each is cloned at .ai/repositories/<owner>/<repo>/ (gitignored) — EXCEPT a source
# that is this repository itself, which is read from its working tree and published
# by copy instead of being vendored (docs/package-format.md).
#
# .ai.toml also carries the operator's SELECTION (Decision-025): per source,
# `categories = ["node", …]` installs the matching subtree (plus each node's
# ancestors' own artifacts) and `artifacts = ["s/<name>", "a/<name>"]` picks
# individually. No selection keys = everything, as before. Selection is a request;
# the installed set is its dependency closure (Decision-029), and an optional
# `ref = "<branch|tag|sha>"` names the pin `kauk update` moves to.
#
# .ai.lock is the ONLY file kauk writes that is meant to be committed (Decision-023/043):
# one entry per vendored source recording the resolved head. `sync` CONVERGES to it and
# never changes content unrequested; `update` MOVES it. A self-published source records
# no head.
#
# A package declares nothing about what it ships. Its contents are determined BY
# CONVENTION and anything outside these directories is ignored:
#   skills/<name>/     -> .claude/skills/<name>
#   agents/<name>.md   -> .claude/agents/<name>.md
#   hooks/<entry>      -> .claude/hooks/<entry>
#   tools/<entry>      -> .claude/tools/<entry>
#   files/<path>       -> <repo root>/<path>          verbatim, no transformation
#
# Everything is a symlink into the clone (absolute, so git worktrees resolve). A
# destination that already holds a real file is reported and skipped, never replaced.
# Where the artifacts land is decided by runtime detection, which yields a SET of
# runtimes rather than a winner; Claude is one destination, never the destination.
#
# package.toml at a repository root declares that it IS a package: name, title,
# description, and `pull-only = true` for a package whose consumers never push back.
set -euo pipefail

SELF_REPO="serialseb/kauk"

die() { printf 'kauk: %s\n' "$1" >&2; exit 1; }
say() { printf '%s\n' "$1"; }

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"; }
clone_of() { echo "$1/.ai/repositories/$2"; }

# ---------- .ai.toml ----------
# The OPERATOR's file: what this checkout consumes. kauk reads it and never writes
# delivery markings into it (Decision-023).
sources_list() { # sources_list <root> -> "<owner>/<repo> <origin>" per line
  local f="$1/.ai.toml"
  [ -f "$f" ] || return 0
  awk '
    /^\[sources\."/ { s=$0; sub(/^\[sources\."/,"",s); sub(/"\].*$/,"",s); src=s; next }
    /^\[/           { src="" }
    src != "" && /^origin[ \t]*=/ {
      v=$0; sub(/^origin[ \t]*=[ \t]*"/,"",v); sub(/".*$/,"",v)
      print src " " v; src=""
    }
  ' "$f"
}

source_origin() { sources_list "$1" | awk -v id="$2" '$1==id{print $2; exit}'; }

ensure_aitoml() { # create if missing; migrate v1 (canonical = "...") in place
  local root=$1 f="$root/.ai.toml" c
  if [ ! -f "$f" ]; then
    cat > "$f" <<'EOF'
# Yours to edit — this file says what this repository consumes.
# Sources live in [sources."<owner>/<repo>"] tables (origin = "URL or local path");
# clones sit at .ai/repositories/<owner>/<repo>/ (gitignored).
EOF
    say ".ai.toml: created"
    return 0
  fi
  c=$(sed -n 's/^canonical *= *"\(.*\)"/\1/p' "$f" | head -1)
  if [ -n "$c" ]; then
    sed -i '/^canonical *= */d; s/managed by orchids/managed by kauk/' "$f"
    grep -q '^\[sources\."serialseb/orchids"\]' "$f" || \
      printf '\n[sources."serialseb/orchids"]\norigin = "%s"\n' "$c" >> "$f"
    say ".ai.toml: migrated v1 canonical → sources table"
  fi
}

register_source() { # register_source <root> <owner>/<repo> <origin> — idempotent
  local root=$1 id=$2 origin=$3 f="$root/.ai.toml"
  grep -q "^\[sources\.\"$id\"\]" "$f" 2>/dev/null && return 0
  printf '\n[sources."%s"]\norigin = "%s"\n' "$id" "$origin" >> "$f"
  say ".ai.toml: registered source $id"
}

source_key_list() { # source_key_list <root> <id> <key> -> quoted strings of that key in the source's table
  [ -f "$1/.ai.toml" ] || return 0
  awk -v id="$2" -v key="$3" '
    /^\[sources\."/ { s=$0; sub(/^\[sources\."/,"",s); sub(/"\].*$/,"",s); cur=s; next }
    /^\[/           { cur="" }
    cur==id && $0 ~ "^"key"[ \t]*=" { n=split($0,a,"\""); for(i=2;i<=n;i+=2) if(a[i]!="") print a[i] }
  ' "$1/.ai.toml"
}

# ---------- frontmatter ----------
# Artifacts describe themselves in YAML frontmatter (Decisions 024/029): `categories:`
# says where a skill or agent files, `dependencies: {skills,agents,tools}` what it
# needs. `roles:` is read as a fallback until the orchids-side rename lands, and an
# agent's runtime `skills:` list counts as skill dependencies (it is the same edge).

fm_block() { awk 'NR==1 && $0!="---"{exit} NR>1 && $0=="---"{exit} NR>1{print}' "$1" 2>/dev/null; }

fm_list() { # fm_list <file> <key> -> items of an inline [a, b] or dash-block list
  [ -f "$1" ] || return 0
  fm_block "$1" | awk -v k="$2" '
    $0 ~ "^"k":[ \t]*\\[" {
      v=$0; sub("^"k":[ \t]*\\[","",v); sub("\\].*$","",v)
      n=split(v,a,","); for(i=1;i<=n;i++){gsub(/^[ \t"'\'']+|[ \t"'\'']+$/,"",a[i]); if(a[i]!="")print a[i]}
      next
    }
    $0 ~ "^"k":[ \t]*$" { inb=1; next }
    inb && /^[ \t]+-[ \t]/ { v=$0; sub(/^[ \t]+-[ \t]+/,"",v); gsub(/^["'\'']|["'\'']$/,"",v); print v; next }
    inb { inb=0 }
  '
}

fm_dep_list() { # fm_dep_list <file> <skills|agents|tools> -> names under dependencies:
  [ -f "$1" ] || return 0
  fm_block "$1" | awk -v k="$2" '
    /^dependencies:[ \t]*$/ { ind=1; next }
    ind && /^[^ \t]/        { ind=0 }
    ind && $0 ~ "^[ \t]+"k":[ \t]*\\[" {
      v=$0; sub("^[ \t]+"k":[ \t]*\\[","",v); sub("\\].*$","",v)
      n=split(v,a,","); for(i=1;i<=n;i++){gsub(/^[ \t"'\'']+|[ \t"'\'']+$/,"",a[i]); if(a[i]!="")print a[i]}
    }
  '
}

artifact_file() { # artifact_file <src> <s|a> <name> -> the file carrying its frontmatter
  case "$2" in
    s) echo "$1/skills/$3/SKILL.md" ;;
    a) echo "$1/agents/$3.md" ;;
  esac
}

artifact_categories() { # artifact_categories <file> — categories:, falling back to roles:
  local c; c=$(fm_list "$1" categories)
  [ -n "$c" ] && { printf '%s\n' "$c"; return 0; }
  fm_list "$1" roles
}

artifact_deps() { # artifact_deps <file> <kind-letter-of-owner> <skills|agents|tools> — kind prefixes stripped
  local f=$1 owner=$2 dk=$3 d
  d=$(fm_dep_list "$f" "$dk")
  # an agent's runtime `skills:` list is the same dependency edge (Decision-029/030)
  [ -z "$d" ] && [ "$owner" = a ] && [ "$dk" = skills ] && d=$(fm_list "$f" skills)
  printf '%s\n' "$d" | sed 's|^[sat]/||' | grep . || true
}

# ---------- selection & closure ----------
# Selection is a request; the installed set is its dependency closure (Decision-025).
# A declared path D matches a selected node N when D==N, D lies under N, or N lies
# under D (an ancestor's own artifact travels with its subtree). An artifact that
# declares NO placement always lays — a package with no categories anywhere installs
# exactly as before. Hooks and files/ carry no frontmatter and are never filtered;
# tools lay unfiltered until they carry frontmatter (Decision-032).
SEL_ACTIVE=0
SEL_FILE=""
XDEPS=""

cat_hit() { # cat_hit <declared-paths (lines)> <selected-nodes (lines)>
  local d n
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      case "$d" in "$n"|"$n"/*) return 0 ;; esac
      case "$n" in "$d"/*) return 0 ;; esac
    done <<< "$2"
  done <<< "$1"
  return 1
}

sel_add() { grep -qx "$2/$3" "$1" 2>/dev/null || echo "$2/$3" >> "$1"; }

sel_allows() { # sel_allows <kind-letter> <name>
  [ "$SEL_ACTIVE" = 0 ] && return 0
  case "$1" in s|a) grep -qx "$1/$2" "$SEL_FILE" ;; *) return 0 ;; esac
}

seed_selection() { # seed_selection <src> <kind-letter> <cats>
  local src=$1 k=$2 cats=$3 t n f decl
  case "$k" in s) set -- "$src"/skills/*/ ;; a) set -- "$src"/agents/*.md ;; esac
  for t in "$@"; do
    [ -e "$t" ] || continue
    n=$(basename "$t" .md)
    f=$(artifact_file "$src" "$k" "$n")
    decl=$(artifact_categories "$f")
    if [ -z "$decl" ] || { [ -n "$cats" ] && cat_hit "$decl" "$cats"; }; then
      sel_add "$SEL_FILE" "$k" "$n"
    fi
  done
}

close_selection() { # close_selection <src> <id> — fixpoint over declared dependencies
  local src=$1 id=$2 grew=1 line k n f dk dn l
  while [ $grew = 1 ]; do
    grew=0
    while IFS=/ read -r k n; do
      case "$k" in s|a) ;; *) continue ;; esac
      f=$(artifact_file "$src" "$k" "$n")
      for dk in skills agents tools; do
        case "$dk" in skills) l=s ;; agents) l=a ;; tools) l=t ;; esac
        for dn in $(artifact_deps "$f" "$k" "$dk"); do
          [ "$l" = t ] && continue            # tools lay unfiltered today
          if [ -e "$(artifact_file "$src" "$l" "$dn")" ]; then
            if ! grep -qx "$l/$dn" "$SEL_FILE"; then
              sel_add "$SEL_FILE" "$l" "$dn"
              say "  closure: +$l/$dn (needed by $k/$n)"
              grew=1
            fi
          else
            echo "$l $dn $k/$n $id" >> "$XDEPS"
          fi
        done
      done
    done < "$SEL_FILE"
  done
}

build_selection() { # build_selection <root> <src> <id> — populates SEL_ACTIVE/SEL_FILE
  local root=$1 src=$2 id=$3 cats arts p
  SEL_ACTIVE=0; : > "$SEL_FILE"
  cats=$(source_key_list "$root" "$id" categories)
  arts=$(source_key_list "$root" "$id" artifacts)
  [ -n "$cats$arts" ] || return 0
  SEL_ACTIVE=1
  seed_selection "$src" s "$cats"
  seed_selection "$src" a "$cats"
  for p in $arts; do
    case "$p" in [sa]/*) echo "$p" >> "$SEL_FILE" ;; t/*) ;; *) say "  WARN $id: artifacts entry '$p' is not k/<name> — ignored" ;; esac
  done
  sort -u -o "$SEL_FILE" "$SEL_FILE"
  close_selection "$src" "$id"
}

resolve_xdeps() { # resolve_xdeps <root> — cross-package closure over the installed union
  local root=$1 l n needer from id origin src f found
  [ -s "$XDEPS" ] || return 0
  sort -u -o "$XDEPS" "$XDEPS"
  while read -r l n needer from; do
    [ -n "$l" ] || continue
    found=""
    while read -r id origin; do
      [ -n "$id" ] && [ "$id" != "$from" ] || continue
      src=$(source_tree "$root" "$id")
      f=$(artifact_file "$src" "$l" "$n")
      [ -e "$f" ] && { found=$id; break; }
    done < <(sources_list "$root")
    if [ -n "$found" ]; then
      lay_one_artifact "$root" "$found" "$l" "$n"
      say "  closure: +$l/$n (from $found, needed by $needer of $from)"
    else
      say "  WARN $from: $needer depends on $l/$n, found in no installed source"
    fi
  done < "$XDEPS"
  : > "$XDEPS"
}

lay_one_artifact() { # lay_one_artifact <root> <owner>/<repo> <kind-letter> <name>
  local root=$1 id=$2 l=$3 n=$4 src mode ns t dstdir
  src=$(source_tree "$root" "$id"); mode=$(publish_mode "$root" "$id"); ns=$(pkg_namespace "$src" "$id")
  case "$l" in
    s) t="$src/skills/$n";    dstdir="$root/.claude/skills" ;;
    a) t="$src/agents/$n.md"; dstdir="$root/.claude/agents"; n="$n.md" ;;
    t) t="$src/tools/$n";     dstdir="$root/.claude/tools" ;;
  esac
  mkdir -p "$dstdir"
  if [ "$mode" = copy ]; then NS_DST="$n"; else namespace_for "$dstdir" "$n" "$ns"; fi
  place_one "$mode" "$t" "$dstdir/$NS_DST" && LAID=$((LAID+1))
}

# ---------- lock ----------
# The committed pin (Decision-043): the only file kauk writes that is meant to be
# committed. One entry per vendored source; a self-published source records no head.
lock_header() {
  cat <<'EOF'
# managed by kauk — do not edit by hand. Records each source's resolved head;
# `kauk sync` converges to it, `kauk update` moves it.
EOF
}

lock_entries() { # lock_entries <root> -> "<id> <sha> <ref>" per line
  [ -f "$1/.ai.lock" ] || return 0
  awk '
    function flush() { if (cur!="" && sha!="") print cur " " sha " " (ref==""?"-":ref); cur=""; sha=""; ref="" }
    /^\[lock\."/ { flush(); s=$0; sub(/^\[lock\."/,"",s); sub(/"\].*$/,"",s); cur=s; next }
    /^\[/        { flush() }
    cur!="" && /^sha[ \t]*=/ { split($0,a,"\""); sha=a[2] }
    cur!="" && /^ref[ \t]*=/ { split($0,a,"\""); ref=a[2] }
    END { flush() }
  ' "$1/.ai.lock"
}

lock_sha() { lock_entries "$1" | awk -v id="$2" '$1==id{print $2; exit}'; }

lock_write() { # lock_write <root> <id> <sha> <ref> — rewrite the entry, keep the rest
  local root=$1 id=$2 sha=$3 ref=$4 f="$root/.ai.lock" tmp
  tmp=$(mktemp)
  { lock_header
    { lock_entries "$root" | awk -v id="$id" '$1!=id'; echo "$id $sha $ref"; } | sort |
    while read -r i s r; do
      printf '\n[lock."%s"]\nsha = "%s"\n' "$i" "$s"
      [ "$r" != "-" ] && printf 'ref = "%s"\n' "$r"
    done
  } > "$tmp"
  mv "$tmp" "$f"
}

# ---------- package dependencies ----------
# A package may declare the sources it needs alongside it: package.toml
# `dependencies = ["<owner>/<repo>", …]` (Decision-038's graph, location-form: the
# slug resolves to https://github.com/<owner>/<repo> unless .ai.toml already names
# an origin). The package graph resolves first; the artifact closure then resolves
# across the union of installed sources.
pkg_dep_sources() { # pkg_dep_sources <src> -> one <owner>/<repo> per line
  [ -f "$1/package.toml" ] || return 0
  awk '/^dependencies[ \t]*=/ { n=split($0,a,"\""); for(i=2;i<=n;i+=2) if(a[i]!="") print a[i] }' "$1/package.toml"
}

ensure_dep_sources() { # ensure_dep_sources <root> <owner>/<repo> — install missing package deps
  local root=$1 id=$2 src dep origin
  src=$(source_tree "$root" "$id")
  for dep in $(pkg_dep_sources "$src"); do
    case "$dep" in */*) ;; *) say "  WARN $id: package dependency '$dep' is not <owner>/<repo> — ignored"; continue ;; esac
    grep -q "^\[sources\.\"$dep\"\]" "$root/.ai.toml" 2>/dev/null && [ -d "$(clone_of "$root" "$dep")/.git" ] && continue
    say "  dependency: $dep (required by $id)"
    origin=$(source_origin "$root" "$dep")
    install_source "$root" "$dep" "${origin:-https://github.com/$dep}" || say "  WARN $id: could not install dependency $dep"
  done
}

# ---------- package identity & convention ----------
# A package is a repository of files that knows nothing about kauk. Its contents are
# determined BY CONVENTION — the directories below — and anything outside them is
# ignored. There is no manifest; the tree is the contract. See docs/package-format.md.
#
# TRANSITIONAL: a repository carrying convention directories but no package.toml is
# still treated as a package, so packages can adopt package.toml on their own schedule.

KINDS="skills agents hooks tools files templates"

pkg_field() { # pkg_field <src> <key> -> value of a bare string key in package.toml
  sed -n "s/^$2[[:space:]]*=[[:space:]]*\"\(.*\)\"/\1/p" "$1/package.toml" 2>/dev/null | head -1
}

pkg_flag() { # pkg_flag <src> <key> — true only for an explicit `key = true`
  grep -Eq "^$2[[:space:]]*=[[:space:]]*true[[:space:]]*$" "$1/package.toml" 2>/dev/null
}

is_package() { # package.toml, or at least one convention directory
  local src=$1 d
  [ -f "$src/package.toml" ] && return 0
  for d in $KINDS; do [ -d "$src/$d" ] && return 0; done
  return 1
}

same_path() { [ -d "$1" ] && [ -d "$2" ] && [ "$(cd "$1" && pwd -P)" = "$(cd "$2" && pwd -P)" ]; }

is_self_source() { # the repository IS this package — never vendored (Decision-037)
  local root=$1 origin; origin=$(source_origin "$root" "$2")
  [ -n "$origin" ] && same_path "$origin" "$root"
}

source_tree() { # where a source's files are read from: its working tree, or its clone
  if is_self_source "$1" "$2"; then echo "$1"; else clone_of "$1" "$2"; fi
}

# A self-published package is COPIED back into its own repository and committed;
# every other package is LINKED (Decision-016/037).
publish_mode() { if is_self_source "$1" "$2"; then echo copy; else echo link; fi; }

managed_paths() { # repo-relative paths this package manages (migration guard scope)
  local src=$1 d
  for d in skills agents hooks tools; do [ -d "$src/$d" ] && printf '.claude/%s\n' "$d"; done
  [ -d "$src/files" ] && (cd "$src/files" && find . -type f 2>/dev/null | sed 's|^\./||')
  return 0
}

# ---------- runtime detection ----------
# Detection yields a SET, not a winner: every runtime in use is served (Decision-018).
detect_runtimes() { # detect_runtimes <root> -> one name per line
  local root=$1
  { [ -d "$root/.claude" ] || [ -f "$root/CLAUDE.md" ]; } && echo claude
  return 0
}

# ---------- layout ----------
LAID=0

place_one() { # place_one <mode> <abs-src> <dst>
  case "$1" in copy) copy_one "$2" "$3" ;; *) link_one "$2" "$3" ;; esac
}

# A name collision is NOT a conflict to merge: two artifacts sharing a name are
# almost certainly different things. Both are kept, under namespaces — the user's
# becomes `local<sep><name>`, the package's `<package><sep><name>` (Decision-042).
# The user merges or renames them later if they want to; kauk decides nothing.
#
# The SEPARATOR is per runtime: kauk adopts whatever syntax each agent already uses
# for namespacing, rather than imposing one. Claude Code writes `plugin:command`.
NS_LOCAL="local"
NS_SEP=":"                                  # set per runtime by its renderer
NS_DST=""                                   # out-param: never echoed, so notices are free

namespace_for() { # namespace_for <dstdir> <name> <pkgns> — sets NS_DST
  local dstdir=$1 n=$2 ns=$3
  # already namespaced by an earlier run: stay namespaced
  if [ -e "$dstdir/$NS_LOCAL$NS_SEP$n" ]; then NS_DST="$ns$NS_SEP$n"; return 0; fi
  # a real entry the user owns sits on the bare name: move it aside, keep both
  if [ -e "$dstdir/$n" ] && [ ! -L "$dstdir/$n" ]; then
    mv "$dstdir/$n" "$dstdir/$NS_LOCAL$NS_SEP$n"
    say "  NAMESPACED $NS_LOCAL$NS_SEP$n (yours) and $ns$NS_SEP$n (package) — same name, different things"
    NS_DST="$ns$NS_SEP$n"; return 0
  fi
  NS_DST="$n"
}

lay_kind() { # lay_kind <mode> <src-dir> <dst-dir> <glob-suffix> <pkgns> <kind-letter>
  local mode=$1 srcdir=$2 dstdir=$3 ns=$5 kind=${6:-} t n
  [ -d "$srcdir" ] || return 0
  mkdir -p "$dstdir"
  for t in "$srcdir"/*$4; do
    [ -e "$t" ] || continue
    n=$(basename "$t")
    case "$n" in .*|__pycache__|*"$NS_SEP"*) continue ;; esac
    [ -n "$kind" ] && ! sel_allows "$kind" "$(basename "$n" .md)" && continue
    # Namespacing only applies where kauk LINKS. In copy mode the destination is a
    # real file because kauk put it there, and must not be mistaken for the user's.
    if [ "$mode" = copy ]; then NS_DST="$n"; else namespace_for "$dstdir" "$n" "$ns"; fi
    place_one "$mode" "$t" "$dstdir/$NS_DST" && LAID=$((LAID+1))
  done
}

lay_claude() { # lay_claude <root> <src> <mode> <pkgns>
  local root=$1 src=$2 mode=$3 ns=$4
  NS_SEP=":"                                # Claude Code's own namespace syntax
  lay_kind "$mode" "$src/skills" "$root/.claude/skills" ""    "$ns" s
  lay_kind "$mode" "$src/agents" "$root/.claude/agents" ".md" "$ns" a
  lay_kind "$mode" "$src/hooks"  "$root/.claude/hooks"  ""    "$ns"
  lay_kind "$mode" "$src/tools"  "$root/.claude/tools"  ""    "$ns"
}

lay_files() { # files/<path> -> <root>/<path>, verbatim (Decision-015)
  local root=$1 src=$2 mode=$3 rel
  [ -d "$src/files" ] || return 0
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    mkdir -p "$root/$(dirname "$rel")"
    place_one "$mode" "$src/files/$rel" "$root/$rel" && LAID=$((LAID+1))
  done < <(cd "$src/files" && find . -type f 2>/dev/null | sed 's|^\./||')
}

pkg_namespace() { # the package's own name, else the repo half of <owner>/<repo>
  local src=$1 id=$2 n; n=$(pkg_field "$src" name)
  echo "${n:-${id##*/}}"
}

lay_source() { # lay_source <root> <owner>/<repo>  (idempotent; never destroys real files)
  local root=$1 id=$2 src mode rt runtimes ns
  src=$(source_tree "$root" "$id")
  is_package "$src" || { say "$id: no package contents — nothing to lay"; return 0; }
  mode=$(publish_mode "$root" "$id")
  ns=$(pkg_namespace "$src" "$id")

  runtimes=$(detect_runtimes "$root")
  if [ -z "$runtimes" ]; then
    say "$id: no agent runtime detected here — nothing laid"
    say "  (a repository is a Claude repository when it has .claude/ or CLAUDE.md)"
    return 0
  fi

  LAID=0
  build_selection "$root" "$src" "$id"
  for rt in $runtimes; do
    case "$rt" in
      claude) lay_claude "$root" "$src" "$mode" "$ns" ;;
      *)      say "  WARN $id: no renderer for runtime '$rt'" ;;
    esac
  done
  lay_files "$root" "$src" "$mode"
  prune_deselected "$root" "$src"
  SEL_ACTIVE=0
  say "$mode: $LAID laid/verified ($id) [$(echo "$runtimes" | tr '\n' ' ')]"
}

prune_deselected() { # prune_deselected <root> <src-tree> — a link whose artifact fell out
  [ "$SEL_ACTIVE" = 1 ] || return 0     # of the selection is removed; its target still
  local root=$1 src=$2 l t k n          # exists, so prune_links would keep it
  for l in "$root"/.claude/skills/* "$root"/.claude/agents/*; do
    [ -L "$l" ] || continue
    t=$(readlink "$l")
    case "$t" in
      "$src"/skills/*) k=s; n=${t#"$src"/skills/}; n=${n%%/*} ;;
      "$src"/agents/*) k=a; n=$(basename "$t" .md) ;;
      *) continue ;;
    esac
    sel_allows "$k" "$n" || { rm "$l"; say "  DESELECT ${l#"$root"/} (outside the selection)"; }
  done
}

CONFLICTS=""

link_one() { # link_one <abs-target> <linkpath> -> 0 correct, 1 blocked
  local target=$1 link=$2
  [ -e "$target" ] || { say "  SKIP $link (target missing in package)"; return 1; }
  if [ -L "$link" ]; then
    [ "$(readlink "$link")" = "$target" ] || ln -sfn "$target" "$link"
    return 0
  fi
  # Report and skip: a destination the user owns is never overwritten (Decision-016).
  # kauk cannot tell the user's intent from anyone else's, so it decides nothing here.
  if [ -e "$link" ]; then
    say "  BLOCKED $link (a real file is already there — kauk did not place it, so kauk will not touch it)"
    CONFLICTS="$CONFLICTS$link|$target"$'\n'
    return 1
  fi
  ln -s "$target" "$link"
}

report_conflicts() { # invite the user to decide — never decide for them (Decision-041)
  [ -n "$CONFLICTS" ] || return 0
  local n; n=$(printf '%s' "$CONFLICTS" | grep -c . || true)
  say ""
  say "$n destination(s) already hold a file kauk did not place. Nothing was changed."
  say "kauk cannot tell which version you intended, so it will not choose. You can:"
  say "  kauk resolve            list them with the package version alongside"
  say "  kauk resolve --assist   ask Claude to attempt a merge, under the usual gates"
  say "  (or merge them yourself — that is always the fallback)"
}

copy_one() { # copy_one <src> <dst> — self-published packages copy into their own repo
  local src=$1 dst=$2
  [ -e "$src" ] || { say "  SKIP $dst (missing in package)"; return 1; }
  # Never recurse-delete anything that is not a published destination.
  case "$dst" in */.claude/*|"$PWD"/*) ;; *) die "refusing to write outside a published destination: $dst" ;; esac
  [ -L "$dst" ] && rm "$dst"                               # was linked, now self-published
  if [ -d "$src" ]; then
    [ -d "$dst" ] && diff -rq "$src" "$dst" >/dev/null 2>&1 && return 0
    rm -rf "${dst:?}"; cp -r "$src" "$dst"; return 0
  fi
  cmp -s "$src" "$dst" 2>/dev/null && return 0
  cp "$src" "$dst"
}

prune_links() { # remove dead symlinks that point into this repo's .ai/repositories/
  local root=$1 l
  while IFS= read -r l; do
    [ -e "$l" ] && continue
    case "$(readlink "$l")" in
      "$root/.ai/repositories/"*) rm "$l"; say "  PRUNE ${l#"$root"/} (target gone from package)" ;;
    esac
  done < <(find "$root/.claude" -type l 2>/dev/null; find "$root" -maxdepth 1 -type l 2>/dev/null)
}

ensure_gitignore() {
  local root=$1
  grep -qx '\.ai/repositories/' "$root/.gitignore" 2>/dev/null || printf '.ai/repositories/\n' >> "$root/.gitignore"
}

# ---------- init ----------
cmd_init() {
  local root; root=$(repo_root)
  local self_clone script_repo
  ensure_aitoml "$root"
  ensure_gitignore "$root"
  # this script may run from the machine canonical or from any vendored clone;
  # the repo being initialized gets its own self-clone either way
  script_repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
  # kauk's own repository is a self-source: it is never vendored into itself.
  if same_path "$script_repo" "$root"; then
    register_source "$root" "$SELF_REPO" "$root"
    lay_source "$root" "$SELF_REPO"
    prune_links "$root"
    say "init: done — this repository is itself the kauk package (self-published)"
    return 0
  fi
  self_clone=$(clone_of "$root" "$SELF_REPO")
  local self_origin
  if [ -d "$self_clone/.git" ]; then
    self_origin=$(git -C "$self_clone" config --get remote.origin.url 2>/dev/null || true)
    self_origin=${self_origin:-${KAUK_ORIGIN:-$script_repo}}
  else
    self_origin="${KAUK_ORIGIN:-$script_repo}"
    mkdir -p "$(dirname "$self_clone")"
    git clone --quiet "$self_origin" "$self_clone"
    say "clone: $self_clone"
  fi
  register_source "$root" "$SELF_REPO" "$self_origin"
  lay_source "$root" "$SELF_REPO"
  prune_links "$root"
  say "init: done — add a data package with 'kauk install <owner>/<repo> [<origin>]'"
}

# ---------- install ----------
install_source() { # install_source <root> <owner>/<repo> <origin> — clone, pin, lay
  local root=$1 id=$2 origin=$3 clone src ref sha
  register_source "$root" "$id" "$origin"
  if is_self_source "$root" "$id"; then
    src="$root"
    say "self: $id is this repository — not vendored, published from the working tree"
  else
    clone=$(clone_of "$root" "$id")
    if [ ! -d "$clone/.git" ]; then
      mkdir -p "$(dirname "$clone")"
      git clone --quiet "$origin" "$clone" || { say "  WARN $id: clone failed from $origin"; return 1; }
      say "clone: $clone"
    else
      say "clone: already present"
    fi
    src="$clone"
    [ -d "$origin/.git" ] && git -C "$origin" config receive.denyCurrentBranch updateInstead
    ref=$(source_key_list "$root" "$id" ref | head -1)
    if [ -n "$ref" ]; then
      git -C "$clone" fetch --quiet --tags origin 2>/dev/null || true
      sha=$(git -C "$clone" rev-parse --verify --quiet "origin/$ref^{commit}") ||
      sha=$(git -C "$clone" rev-parse --verify --quiet "$ref^{commit}") ||
        { say "  WARN $id: ref '$ref' not found"; return 1; }
      git -C "$clone" checkout --quiet "$sha"
    else
      sha=$(git -C "$clone" rev-parse HEAD)
    fi
    lock_write "$root" "$id" "$sha" "${ref:--}"
    say "lock: $id pinned at ${sha:0:7}${ref:+ ($ref)}"
  fi
  is_package "$src" || { say "  WARN $id has no package contents — not a kauk package (expects any of: $KINDS)"; return 1; }

  # A destination the user owns is REPORTED AND SKIPPED — never deleted, never merged
  # on their behalf, and nothing is dispatched to resolve it (Decision-016). Installing
  # does not write to the package either: kauk never adopts a consumer's file upstream.
  lay_source "$root" "$id"
  ensure_dep_sources "$root" "$id"
}

offer_categories() { # offer_categories <root> <id> — the browsable tree (Decision-025)
  local root=$1 id=$2 src cats f
  [ -z "$(source_key_list "$root" "$id" categories)$(source_key_list "$root" "$id" artifacts)" ] || return 0
  src=$(source_tree "$root" "$id")
  cats=$({ for f in "$src"/skills/*/SKILL.md "$src"/agents/*.md; do artifact_categories "$f"; done; } 2>/dev/null | sort -u | grep . || true)
  [ -n "$cats" ] || return 0
  say ""
  say "$id declares categories; nothing is selected, so everything installed. To trim,"
  say "add under [sources.\"$id\"] in .ai.toml (subtrees included, dependencies follow):"
  say "  categories = [$(echo "$cats" | sed 's/.*/"&"/' | paste -sd ', ' -)]"
  say "  (drop the nodes this repository does not need; artifacts = [\"s/<name>\"] picks one)"
}

cmd_install() {
  local id=${1:-} origin=${2:-}
  [ -n "$id" ] || die "usage: kauk install <owner>/<repo> [<origin>]"
  case "$id" in */*) ;; *) die "source must be <owner>/<repo>" ;; esac
  local root; root=$(repo_root)
  origin=${origin:-$(source_origin "$root" "$id")}
  origin=${origin:-https://github.com/$id}

  ensure_aitoml "$root"
  ensure_gitignore "$root"
  install_source "$root" "$id" "$origin" || die "install: $id failed"
  resolve_xdeps "$root"
  prune_links "$root"
  say "install: $id done"
  offer_categories "$root" "$id"
  report_conflicts
}

# ---------- resolve ----------
# The manual-resolution point. kauk never reaches it on its own: the user asks.
collect_conflicts() { # collect_conflicts <root> — re-run layout to populate CONFLICTS
  local root=$1 id origin
  CONFLICTS=""
  while read -r id origin; do
    [ -n "$id" ] || continue
    lay_source "$root" "$id" >/dev/null
  done < <(sources_list "$root")
}

cmd_resolve() {
  local root; root=$(repo_root)
  local assist=0
  [ "${1:-}" = "--assist" ] && assist=1
  collect_conflicts "$root"
  [ -n "$CONFLICTS" ] || { say "resolve: nothing to resolve — no destination holds a file kauk did not place"; return 0; }

  local link target list=""
  while IFS='|' read -r link target; do
    [ -n "$link" ] || continue
    say "  ${link#"$root"/}"
    say "      yours:   $link"
    say "      package: $target"
    list="$list ${link#"$root"/}"
  done < <(printf '%s' "$CONFLICTS")

  if [ $assist = 0 ]; then
    say ""
    say "Merge them yourself, or run 'kauk resolve --assist' to have Claude attempt it."
    return 0
  fi

  command -v claude >/dev/null 2>&1 || die "claude is not on PATH — merge these yourself"
  say ""
  say "Attempting an assisted merge for:$list"
  say "It follows the normal gates: it proposes, you approve, nothing is committed."
  claude -p "You are in the git repository $root. These paths each hold a file the user owns, and a package wants to provide its own version at the same path:$list. For EACH: read the user's file, read the package version (the path is printed above as 'package:'), and judge whether a SIMPLE, unambiguous merge exists — one that loses nothing the user wrote. If it does, show the proposed result and explain it. If it does not, say so plainly and stop: the user resolves it themselves. Change nothing on disk. Commit nothing." --output-format text \
    || say "assisted merge did not complete — resolve these yourself"
}

# ---------- sync ----------
# `sync` CONVERGES to the lock and never changes content unrequested (Decision-043).
# The one thing it still publishes is the operator's own local edits to an editable
# clone — those are a requested change, pushed back and re-locked. Everything that
# MOVES the pin lives in `kauk update`.
publish_local_edits() { # publish_local_edits <root> <owner>/<repo> <clone> -> 0 if lock moved
  local root=$1 id=$2 clone=$3 sha r
  [ -n "$(git -C "$clone" status --porcelain)" ] || return 1
  if pkg_flag "$clone" pull-only; then
    say "$id: pull-only package has local edits — never pushed back; resolve manually"
    return 1
  fi
  git -C "$clone" add -A
  git -C "$clone" commit --quiet -m "🔁 sync: local edits from $(basename "$root")"
  git -C "$clone" push --quiet origin HEAD:main || say "$id: push of local edits failed (offline?) — they stay committed in the clone"
  sha=$(git -C "$clone" rev-parse HEAD)
  r=$(source_key_list "$root" "$id" ref | head -1)
  lock_write "$root" "$id" "$sha" "${r:--}"
  say "$id: local edits published — lock moved to ${sha:0:7}"
}

sync_source() { # sync_source <root> <owner>/<repo> — converge, move nothing
  local root=$1 id=$2 clone sha head origin
  # A self-published package is never vendored: publish straight from the working tree.
  if is_self_source "$root" "$id"; then
    lay_source "$root" "$id"
    say "sync: $id (self-published from the working tree — not vendored)"
    return 0
  fi
  clone=$(clone_of "$root" "$id")
  sha=$(lock_sha "$root" "$id")
  if [ ! -d "$clone/.git" ]; then
    # a fresh checkout: the lock is what makes the clone reproducible
    origin=$(source_origin "$root" "$id")
    [ -n "$origin" ] || { say "$id: no clone and no origin — run 'kauk install $id'"; return 0; }
    mkdir -p "$(dirname "$clone")"
    git clone --quiet "$origin" "$clone" || { say "$id: clone failed (offline?)"; return 0; }
    say "clone: $clone"
    [ -d "$origin/.git" ] && git -C "$origin" config receive.denyCurrentBranch updateInstead
  fi
  publish_local_edits "$root" "$id" "$clone" && sha=$(lock_sha "$root" "$id")
  head=$(git -C "$clone" rev-parse HEAD)
  if [ -z "$sha" ]; then
    lock_write "$root" "$id" "$head" "-"
    say "lock: $id pinned at ${head:0:7}"
  elif [ "$head" != "$sha" ]; then
    if ! git -C "$clone" checkout --quiet "$sha" 2>/dev/null; then
      git -C "$clone" fetch --quiet --tags origin 2>/dev/null || true
      git -C "$clone" checkout --quiet "$sha" 2>/dev/null || \
        { say "$id: locked ${sha:0:7} is in neither clone nor origin — nothing changed; how to proceed is yours"; return 0; }
    fi
    say "$id: converged to locked ${sha:0:7}"
  fi
  ensure_dep_sources "$root" "$id"
  lay_source "$root" "$id"
  say "sync: $id ($(git -C "$clone" rev-parse --short HEAD) — pinned)"
}

# ---------- update ----------
# The operator-owned moment content changes (Decision-043): fetch (tags too), move
# the pin to the asked ref — `ref = "<branch|tag|sha>"` in the source's table, main
# by default — then run pending migrations (Decision-022) and warn, without
# repairing, when the delta removes or renames artifacts a session may still hold.
pkg_artifact_names() { # pkg_artifact_names <src> -> kind/name per line, sorted
  local src=$1 t
  { for t in "$src"/skills/*/; do [ -e "$t" ] && echo "s/$(basename "$t")"; done
    for t in "$src"/agents/*.md; do [ -e "$t" ] && echo "a/$(basename "$t" .md)"; done
    for t in "$src"/hooks/* "$src"/tools/*; do [ -e "$t" ] && echo "x/$(basename "$t")"; done
  } 2>/dev/null | sort
}

run_pending_migrations() { # run_pending_migrations <root> <owner>/<repo> <src>
  local root=$1 id=$2 src=$3 gcd wm last f base
  [ -d "$src/migrations" ] || return 0
  gcd=$(git -C "$root" rev-parse --git-common-dir)
  case "$gcd" in /*) ;; *) gcd="$root/$gcd" ;; esac
  wm="$gcd/the-works/migrated/$id"; last=""
  [ -f "$wm" ] && last=$(cat "$wm")
  for f in "$src"/migrations/*.md; do
    [ -e "$f" ] || continue
    base=$(basename "$f" .md)
    if [ -n "$last" ]; then [ "$base" \> "$last" ] || continue; fi
    say "  migration $base: running scripted steps"
    if awk '/^```sh$/{b=1;next} /^```/{b=0} b' "$f" | (cd "$root" && bash); then
      mkdir -p "$(dirname "$wm")"; printf '%s\n' "$base" > "$wm"
      say "  migration $base: applied (judgement steps, if any, are prose in the file)"
    else
      say "  migration $base: FAILED — apply manually, then advance $wm"
      return 1
    fi
  done
}

update_source() { # update_source <root> <owner>/<repo>
  local root=$1 id=$2 clone ref target sha cur before after gone
  if is_self_source "$root" "$id"; then
    say "update: $id is self-published — nothing to move"
    return 0
  fi
  clone=$(clone_of "$root" "$id")
  [ -d "$clone/.git" ] || { say "$id: no clone — run 'kauk install $id' first"; return 0; }
  publish_local_edits "$root" "$id" "$clone" || true
  git -C "$clone" fetch --quiet --tags origin || { say "$id: fetch failed (offline?) — pin not moved"; return 0; }
  ref=$(source_key_list "$root" "$id" ref | head -1)
  target=${ref:-main}
  sha=$(git -C "$clone" rev-parse --verify --quiet "origin/$target^{commit}") ||
  sha=$(git -C "$clone" rev-parse --verify --quiet "$target^{commit}") ||
    { say "$id: '$target' resolves to nothing after fetch — pin not moved"; return 0; }
  before=$(pkg_artifact_names "$clone")
  cur=$(git -C "$clone" rev-parse HEAD)
  if [ "$cur" = "$sha" ]; then
    lock_write "$root" "$id" "$sha" "${ref:--}"
    say "update: $id already at ${sha:0:7}${ref:+ ($ref)}"
  else
    git -C "$clone" checkout --quiet "$sha"
    lock_write "$root" "$id" "$sha" "${ref:--}"
    say "update: $id $(git -C "$clone" rev-parse --short "$cur") → ${sha:0:7}${ref:+ ($ref)}"
  fi
  after=$(pkg_artifact_names "$clone")
  gone=$(comm -23 <(echo "$before") <(echo "$after") | grep . || true)
  if [ -n "$gone" ]; then
    say "  WARN $id: this update removes or renames artifacts a running session may still hold — restarting is your call:"
    echo "$gone" | sed 's/^/    /'
  fi
  lay_source "$root" "$id"
  run_pending_migrations "$root" "$id" "$clone" || true
  ensure_dep_sources "$root" "$id"
}

cmd_update() {
  local only=${1:-} root; root=$(repo_root)
  local list; list=$(sources_list "$root")
  [ -n "$list" ] || die "no sources in .ai.toml — run 'kauk init' first"
  if [ -n "$only" ]; then
    echo "$list" | awk -v id="$only" '$1==id{f=1} END{exit !f}' || die "unknown source: $only"
  fi
  local id origin
  while read -r id origin; do
    [ -n "$id" ] || continue
    [ -n "$only" ] && [ "$id" != "$only" ] && continue
    update_source "$root" "$id"
  done <<< "$list"
  resolve_xdeps "$root"
  prune_links "$root"
  report_conflicts
}

status_source() { # status_source <root> <owner>/<repo>
  local root=$1 id=$2 clone dirty ahead behind
  clone=$(clone_of "$root" "$id")
  [ -d "$clone/.git" ] || { say "$id: no clone"; return 0; }
  git -C "$clone" fetch --quiet origin || { say "$id: fetch failed (offline?)"; return 0; }
  dirty=$(git -C "$clone" status --porcelain | wc -l)
  ahead=$(git -C "$clone" rev-list --count origin/main..HEAD)
  behind=$(git -C "$clone" rev-list --count HEAD..origin/main)
  say "$id: $behind incoming · $ahead outgoing · $dirty uncommitted local edit(s)"
  lay_source "$root" "$id"
}

cmd_sync() {
  local root; root=$(repo_root)
  local status_only=0
  [ "${1:-}" = "--status" ] && status_only=1
  local list; list=$(sources_list "$root")
  [ -n "$list" ] || die "no sources in .ai.toml — run 'kauk init' first"
  local id origin
  # data sources first; the kauk self-clone (pull-only) last
  while read -r id origin; do
    [ -n "$id" ] || continue
    if [ $status_only = 1 ]; then status_source "$root" "$id"; else sync_source "$root" "$id"; fi
  done < <({ echo "$list" | grep -v "^$SELF_REPO " || true; echo "$list" | grep "^$SELF_REPO " || true; })
  [ $status_only = 1 ] || resolve_xdeps "$root"
  prune_links "$root"
  report_conflicts
}

main() {
  SEL_FILE=$(mktemp); XDEPS=$(mktemp)
  trap 'rm -f "$SEL_FILE" "$XDEPS"' EXIT
  case "${1:-}" in
    init)    shift; cmd_init "$@" ;;
    install) shift; cmd_install "$@" ;;
    sync)    shift; cmd_sync "$@" ;;
    update)  shift; cmd_update "$@" ;;
    resolve) shift; cmd_resolve "$@" ;;
    *) die "usage: kauk init | install <owner>/<repo> [<origin>] | sync [--status] | update [<owner>/<repo>] | resolve [--assist]" ;;
  esac
}
main "$@"
