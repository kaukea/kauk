#!/usr/bin/env bash
# kauk — stopgap distribution of file packages (skills, agents, shared rule
# files) for AI-agent-driven repositories. The real `kauk` CLI ships at 0.1.0 and
# inherits this grammar; until then this bash MVP dies gracefully: delete .ai/ and
# the symlinks, nothing else breaks.
#
#   kauk init                               bootstrap THIS repo (no data source)
#   kauk install <owner>/<repo> [<origin>]  vendor + lay a data package
#   kauk sync [--status]                    converge every installed source
#   kauk resolve [--assist]                 list destinations kauk refused to touch;
#                                           --assist asks Claude to attempt a merge
#
# Sources are recorded in .ai.toml ([sources."<owner>/<repo>"] origin = "URL|path");
# each is cloned at .ai/repositories/<owner>/<repo>/ (gitignored) — EXCEPT a source
# that is this repository itself, which is read from its working tree and published
# by copy instead of being vendored (docs/package-format.md).
#
# A package declares nothing about what it ships. Its contents are determined BY
# CONVENTION and anything outside these directories is ignored:
#   skills/<name>/     -> .claude/skills/<name>
#   agents/<name>.md   -> .claude/agents/<name>.md
#   hooks/<entry>      -> .claude/hooks/<entry>
#   tools/<entry>      -> .claude/tools/<entry>
#   files/<path>       -> <repo root>/<path>          verbatim, no transformation
#
# Everything is a symlink into the clone (absolute, so git worktrees resolve). A
# destination that already holds a real file is reported and skipped, never replaced.
# Where the artifacts land is decided by runtime detection, which yields a SET of
# runtimes rather than a winner; Claude is one destination, never the destination.
#
# package.toml at a repository root declares that it IS a package: name, title,
# description, and `pull-only = true` for a package whose consumers never push back.
set -euo pipefail

SELF_REPO="serialseb/kauk"

die() { printf 'kauk: %s\n' "$1" >&2; exit 1; }
say() { printf '%s\n' "$1"; }

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"; }
clone_of() { echo "$1/.ai/repositories/$2"; }

# ---------- .ai.toml ----------
# The OPERATOR's file: what this checkout consumes. kauk reads it and never writes
# delivery markings into it (Decision-023).
sources_list() { # sources_list <root> -> "<owner>/<repo> <origin>" per line
  local f="$1/.ai.toml"
  [ -f "$f" ] || return 0
  awk '
    /^\[sources\."/ { s=$0; sub(/^\[sources\."/,"",s); sub(/"\].*$/,"",s); src=s; next }
    /^\[/           { src="" }
    src != "" && /^origin[ \t]*=/ {
      v=$0; sub(/^origin[ \t]*=[ \t]*"/,"",v); sub(/".*$/,"",v)
      print src " " v; src=""
    }
  ' "$f"
}

source_origin() { sources_list "$1" | awk -v id="$2" '$1==id{print $2; exit}'; }

ensure_aitoml() { # create if missing; migrate v1 (canonical = "...") in place
  local root=$1 f="$root/.ai.toml" c
  if [ ! -f "$f" ]; then
    cat > "$f" <<'EOF'
# Yours to edit — this file says what this repository consumes.
# Sources live in [sources."<owner>/<repo>"] tables (origin = "URL or local path");
# clones sit at .ai/repositories/<owner>/<repo>/ (gitignored).
EOF
    say ".ai.toml: created"
    return 0
  fi
  c=$(sed -n 's/^canonical *= *"\(.*\)"/\1/p' "$f" | head -1)
  if [ -n "$c" ]; then
    sed -i '/^canonical *= */d; s/managed by orchids/managed by kauk/' "$f"
    grep -q '^\[sources\."serialseb/orchids"\]' "$f" || \
      printf '\n[sources."serialseb/orchids"]\norigin = "%s"\n' "$c" >> "$f"
    say ".ai.toml: migrated v1 canonical → sources table"
  fi
}

register_source() { # register_source <root> <owner>/<repo> <origin> — idempotent
  local root=$1 id=$2 origin=$3 f="$root/.ai.toml"
  grep -q "^\[sources\.\"$id\"\]" "$f" 2>/dev/null && return 0
  printf '\n[sources."%s"]\norigin = "%s"\n' "$id" "$origin" >> "$f"
  say ".ai.toml: registered source $id"
}

# ---------- package identity & convention ----------
# A package is a repository of files that knows nothing about kauk. Its contents are
# determined BY CONVENTION — the directories below — and anything outside them is
# ignored. There is no manifest; the tree is the contract. See docs/package-format.md.
#
# TRANSITIONAL: a repository carrying convention directories but no package.toml is
# still treated as a package, so packages can adopt package.toml on their own schedule.

KINDS="skills agents hooks tools files templates"

pkg_field() { # pkg_field <src> <key> -> value of a bare string key in package.toml
  sed -n "s/^$2[[:space:]]*=[[:space:]]*\"\(.*\)\"/\1/p" "$1/package.toml" 2>/dev/null | head -1
}

pkg_flag() { # pkg_flag <src> <key> — true only for an explicit `key = true`
  grep -Eq "^$2[[:space:]]*=[[:space:]]*true[[:space:]]*$" "$1/package.toml" 2>/dev/null
}

is_package() { # package.toml, or at least one convention directory
  local src=$1 d
  [ -f "$src/package.toml" ] && return 0
  for d in $KINDS; do [ -d "$src/$d" ] && return 0; done
  return 1
}

same_path() { [ -d "$1" ] && [ -d "$2" ] && [ "$(cd "$1" && pwd -P)" = "$(cd "$2" && pwd -P)" ]; }

is_self_source() { # the repository IS this package — never vendored (Decision-037)
  local root=$1 origin; origin=$(source_origin "$root" "$2")
  [ -n "$origin" ] && same_path "$origin" "$root"
}

source_tree() { # where a source's files are read from: its working tree, or its clone
  if is_self_source "$1" "$2"; then echo "$1"; else clone_of "$1" "$2"; fi
}

# A self-published package is COPIED back into its own repository and committed;
# every other package is LINKED (Decision-016/037).
publish_mode() { if is_self_source "$1" "$2"; then echo copy; else echo link; fi; }

managed_paths() { # repo-relative paths this package manages (migration guard scope)
  local src=$1 d
  for d in skills agents hooks tools; do [ -d "$src/$d" ] && printf '.claude/%s\n' "$d"; done
  [ -d "$src/files" ] && (cd "$src/files" && find . -type f 2>/dev/null | sed 's|^\./||')
  return 0
}

# ---------- runtime detection ----------
# Detection yields a SET, not a winner: every runtime in use is served (Decision-018).
detect_runtimes() { # detect_runtimes <root> -> one name per line
  local root=$1
  { [ -d "$root/.claude" ] || [ -f "$root/CLAUDE.md" ]; } && echo claude
  return 0
}

# ---------- layout ----------
LAID=0

place_one() { # place_one <mode> <abs-src> <dst>
  case "$1" in copy) copy_one "$2" "$3" ;; *) link_one "$2" "$3" ;; esac
}

lay_kind() { # lay_kind <mode> <src-dir> <dst-dir> <glob-suffix>
  local mode=$1 srcdir=$2 dstdir=$3 t n
  [ -d "$srcdir" ] || return 0
  mkdir -p "$dstdir"
  for t in "$srcdir"/*$4; do
    [ -e "$t" ] || continue
    n=$(basename "$t")
    case "$n" in .*|__pycache__) continue ;; esac
    place_one "$mode" "$t" "$dstdir/$n" && LAID=$((LAID+1))
  done
}

lay_claude() { # lay_claude <root> <src> <mode>
  local root=$1 src=$2 mode=$3
  lay_kind "$mode" "$src/skills" "$root/.claude/skills" ""
  lay_kind "$mode" "$src/agents" "$root/.claude/agents" ".md"
  lay_kind "$mode" "$src/hooks"  "$root/.claude/hooks"  ""
  lay_kind "$mode" "$src/tools"  "$root/.claude/tools"  ""
}

lay_files() { # files/<path> -> <root>/<path>, verbatim (Decision-015)
  local root=$1 src=$2 mode=$3 rel
  [ -d "$src/files" ] || return 0
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    mkdir -p "$root/$(dirname "$rel")"
    place_one "$mode" "$src/files/$rel" "$root/$rel" && LAID=$((LAID+1))
  done < <(cd "$src/files" && find . -type f 2>/dev/null | sed 's|^\./||')
}

lay_source() { # lay_source <root> <owner>/<repo>  (idempotent; never destroys real files)
  local root=$1 id=$2 src mode rt runtimes
  src=$(source_tree "$root" "$id")
  is_package "$src" || { say "$id: no package contents — nothing to lay"; return 0; }
  mode=$(publish_mode "$root" "$id")

  runtimes=$(detect_runtimes "$root")
  if [ -z "$runtimes" ]; then
    say "$id: no agent runtime detected here — nothing laid"
    say "  (a repository is a Claude repository when it has .claude/ or CLAUDE.md)"
    return 0
  fi

  LAID=0
  for rt in $runtimes; do
    case "$rt" in
      claude) lay_claude "$root" "$src" "$mode" ;;
      *)      say "  WARN $id: no renderer for runtime '$rt'" ;;
    esac
  done
  lay_files "$root" "$src" "$mode"
  say "$mode: $LAID laid/verified ($id) [$(echo "$runtimes" | tr '\n' ' ')]"
}

CONFLICTS=""

link_one() { # link_one <abs-target> <linkpath> -> 0 correct, 1 blocked
  local target=$1 link=$2
  [ -e "$target" ] || { say "  SKIP $link (target missing in package)"; return 1; }
  if [ -L "$link" ]; then
    [ "$(readlink "$link")" = "$target" ] || ln -sfn "$target" "$link"
    return 0
  fi
  # Report and skip: a destination the user owns is never overwritten (Decision-016).
  # kauk cannot tell the user's intent from anyone else's, so it decides nothing here.
  if [ -e "$link" ]; then
    say "  BLOCKED $link (a real file is already there — kauk did not place it, so kauk will not touch it)"
    CONFLICTS="$CONFLICTS$link|$target"$'\n'
    return 1
  fi
  ln -s "$target" "$link"
}

report_conflicts() { # invite the user to decide — never decide for them (Decision-041)
  [ -n "$CONFLICTS" ] || return 0
  local n; n=$(printf '%s' "$CONFLICTS" | grep -c . || true)
  say ""
  say "$n destination(s) already hold a file kauk did not place. Nothing was changed."
  say "kauk cannot tell which version you intended, so it will not choose. You can:"
  say "  kauk resolve            list them with the package version alongside"
  say "  kauk resolve --assist   ask Claude to attempt a merge, under the usual gates"
  say "  (or merge them yourself — that is always the fallback)"
}

copy_one() { # copy_one <src> <dst> — self-published packages copy into their own repo
  local src=$1 dst=$2
  [ -e "$src" ] || { say "  SKIP $dst (missing in package)"; return 1; }
  # Never recurse-delete anything that is not a published destination.
  case "$dst" in */.claude/*|"$PWD"/*) ;; *) die "refusing to write outside a published destination: $dst" ;; esac
  [ -L "$dst" ] && rm "$dst"                               # was linked, now self-published
  if [ -d "$src" ]; then
    [ -d "$dst" ] && diff -rq "$src" "$dst" >/dev/null 2>&1 && return 0
    rm -rf "${dst:?}"; cp -r "$src" "$dst"; return 0
  fi
  cmp -s "$src" "$dst" 2>/dev/null && return 0
  cp "$src" "$dst"
}

prune_links() { # remove dead symlinks that point into this repo's .ai/repositories/
  local root=$1 l
  while IFS= read -r l; do
    [ -e "$l" ] && continue
    case "$(readlink "$l")" in
      "$root/.ai/repositories/"*) rm "$l"; say "  PRUNE ${l#"$root"/} (target gone from package)" ;;
    esac
  done < <(find "$root/.claude" -type l 2>/dev/null; find "$root" -maxdepth 1 -type l 2>/dev/null)
}

ensure_gitignore() {
  local root=$1
  grep -qx '\.ai/repositories/' "$root/.gitignore" 2>/dev/null || printf '.ai/repositories/\n' >> "$root/.gitignore"
}

# ---------- init ----------
cmd_init() {
  local root; root=$(repo_root)
  local self_clone script_repo
  ensure_aitoml "$root"
  ensure_gitignore "$root"
  # this script may run from the machine canonical or from any vendored clone;
  # the repo being initialized gets its own self-clone either way
  script_repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
  # kauk's own repository is a self-source: it is never vendored into itself.
  if same_path "$script_repo" "$root"; then
    register_source "$root" "$SELF_REPO" "$root"
    lay_source "$root" "$SELF_REPO"
    prune_links "$root"
    say "init: done — this repository is itself the kauk package (self-published)"
    return 0
  fi
  self_clone=$(clone_of "$root" "$SELF_REPO")
  local self_origin
  if [ -d "$self_clone/.git" ]; then
    self_origin=$(git -C "$self_clone" config --get remote.origin.url 2>/dev/null || true)
    self_origin=${self_origin:-${KAUK_ORIGIN:-$script_repo}}
  else
    self_origin="${KAUK_ORIGIN:-$script_repo}"
    mkdir -p "$(dirname "$self_clone")"
    git clone --quiet "$self_origin" "$self_clone"
    say "clone: $self_clone"
  fi
  register_source "$root" "$SELF_REPO" "$self_origin"
  lay_source "$root" "$SELF_REPO"
  prune_links "$root"
  say "init: done — add a data package with 'kauk install <owner>/<repo> [<origin>]'"
}

# ---------- install ----------
cmd_install() {
  local id=${1:-} origin=${2:-}
  [ -n "$id" ] || die "usage: kauk install <owner>/<repo> [<origin>]"
  case "$id" in */*) ;; *) die "source must be <owner>/<repo>" ;; esac
  local root clone; root=$(repo_root); clone=$(clone_of "$root" "$id")
  origin=${origin:-$(source_origin "$root" "$id")}
  origin=${origin:-https://github.com/$id}

  ensure_aitoml "$root"
  ensure_gitignore "$root"
  register_source "$root" "$id" "$origin"

  local src
  if is_self_source "$root" "$id"; then
    src="$root"
    say "self: $id is this repository — not vendored, published from the working tree"
  else
    if [ ! -d "$clone/.git" ]; then
      mkdir -p "$(dirname "$clone")"
      git clone --quiet "$origin" "$clone"
      say "clone: $clone"
    else
      say "clone: already present"
    fi
    src="$clone"
    [ -d "$origin/.git" ] && git -C "$origin" config receive.denyCurrentBranch updateInstead
  fi
  is_package "$src" || die "$id has no package contents — not a kauk package (expects any of: $KINDS)"

  # A destination the user owns is REPORTED AND SKIPPED — never deleted, never merged
  # on their behalf, and nothing is dispatched to resolve it (Decision-016). Installing
  # does not write to the package either: kauk never adopts a consumer's file upstream.
  lay_source "$root" "$id"
  prune_links "$root"
  say "install: $id done"
  report_conflicts
}

# ---------- resolve ----------
# The manual-resolution point. kauk never reaches it on its own: the user asks.
collect_conflicts() { # collect_conflicts <root> — re-run layout to populate CONFLICTS
  local root=$1 id origin
  CONFLICTS=""
  while read -r id origin; do
    [ -n "$id" ] || continue
    lay_source "$root" "$id" >/dev/null
  done < <(sources_list "$root")
}

cmd_resolve() {
  local root; root=$(repo_root)
  local assist=0
  [ "${1:-}" = "--assist" ] && assist=1
  collect_conflicts "$root"
  [ -n "$CONFLICTS" ] || { say "resolve: nothing to resolve — no destination holds a file kauk did not place"; return 0; }

  local link target list=""
  while IFS='|' read -r link target; do
    [ -n "$link" ] || continue
    say "  ${link#"$root"/}"
    say "      yours:   $link"
    say "      package: $target"
    list="$list ${link#"$root"/}"
  done < <(printf '%s' "$CONFLICTS")

  if [ $assist = 0 ]; then
    say ""
    say "Merge them yourself, or run 'kauk resolve --assist' to have Claude attempt it."
    return 0
  fi

  command -v claude >/dev/null 2>&1 || die "claude is not on PATH — merge these yourself"
  say ""
  say "Attempting an assisted merge for:$list"
  say "It follows the normal gates: it proposes, you approve, nothing is committed."
  claude -p "You are in the git repository $root. These paths each hold a file the user owns, and a package wants to provide its own version at the same path:$list. For EACH: read the user's file, read the package version (the path is printed above as 'package:'), and judge whether a SIMPLE, unambiguous merge exists — one that loses nothing the user wrote. If it does, show the proposed result and explain it. If it does not, say so plainly and stop: the user resolves it themselves. Change nothing on disk. Commit nothing." --output-format text \
    || say "assisted merge did not complete — resolve these yourself"
}

# ---------- sync ----------
sync_source() { # sync_source <root> <owner>/<repo>
  local root=$1 id=$2 clone
  # A self-published package is never vendored: publish straight from the working tree.
  if is_self_source "$root" "$id"; then
    lay_source "$root" "$id"
    say "sync: $id (self-published from the working tree — not vendored)"
    return 0
  fi
  clone=$(clone_of "$root" "$id")
  [ -d "$clone/.git" ] || { say "$id: no clone — run 'kauk install $id' first"; return 0; }

  if pkg_flag "$clone" pull-only; then
    if [ -n "$(git -C "$clone" status --porcelain)" ]; then
      say "$id: pull-only package has local edits — never pushed back; resolve manually (pull skipped)"
    else
      git -C "$clone" pull --rebase --quiet origin main || say "$id: pull failed (offline?)"
    fi
    lay_source "$root" "$id"
    say "sync: $id ($(git -C "$clone" rev-parse --short HEAD) — pull-only)"
    return 0
  fi

  if [ -n "$(git -C "$clone" status --porcelain)" ]; then
    git -C "$clone" add -A
    git -C "$clone" commit --quiet -m "🔁 sync: local edits from $(basename "$root")"
    say "$id: committed local edits"
  fi
  if ! git -C "$clone" pull --rebase --quiet origin main; then
    say "CONFLICT — $id and this repo edited the same skill."
    say "Resolve in $clone (skills change rarely, are added often — a union merge is usually right),"
    say "then: git -C $clone rebase --continue && kauk sync"
    exit 1
  fi
  git -C "$clone" push --quiet origin main

  lay_source "$root" "$id"
  say "sync: $id ($(git -C "$clone" rev-parse --short HEAD) — in step with its source)"
}

status_source() { # status_source <root> <owner>/<repo>
  local root=$1 id=$2 clone dirty ahead behind
  clone=$(clone_of "$root" "$id")
  [ -d "$clone/.git" ] || { say "$id: no clone"; return 0; }
  git -C "$clone" fetch --quiet origin || { say "$id: fetch failed (offline?)"; return 0; }
  dirty=$(git -C "$clone" status --porcelain | wc -l)
  ahead=$(git -C "$clone" rev-list --count origin/main..HEAD)
  behind=$(git -C "$clone" rev-list --count HEAD..origin/main)
  say "$id: $behind incoming · $ahead outgoing · $dirty uncommitted local edit(s)"
  lay_source "$root" "$id"
}

cmd_sync() {
  local root; root=$(repo_root)
  local status_only=0
  [ "${1:-}" = "--status" ] && status_only=1
  local list; list=$(sources_list "$root")
  [ -n "$list" ] || die "no sources in .ai.toml — run 'kauk init' first"
  local id origin
  # data sources first; the kauk self-clone (pull-only) last
  while read -r id origin; do
    [ -n "$id" ] || continue
    if [ $status_only = 1 ]; then status_source "$root" "$id"; else sync_source "$root" "$id"; fi
  done < <({ echo "$list" | grep -v "^$SELF_REPO " || true; echo "$list" | grep "^$SELF_REPO " || true; })
  prune_links "$root"
  report_conflicts
}

main() {
  case "${1:-}" in
    init)    shift; cmd_init "$@" ;;
    install) shift; cmd_install "$@" ;;
    sync)    shift; cmd_sync "$@" ;;
    resolve) shift; cmd_resolve "$@" ;;
    *) die "usage: kauk init | install <owner>/<repo> [<origin>] | sync [--status] | resolve [--assist]" ;;
  esac
}
main "$@"
